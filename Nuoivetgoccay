loadstring([[
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")

pcall(function()
	if pg:FindFirstChild("FloatAimSpeedTP") then
		pg.FloatAimSpeedTP:Destroy()
	end
end)

local savedY, floorOn, floorPart = nil, false, nil
local aimOn, selectedTarget = false, nil
local speedOn, speedValue = false, 16
local tpTarget = nil

local gui = Instance.new("ScreenGui")
gui.Name = "FloatAimSpeedTP"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 999
gui.Parent = pg

local openBtn = Instance.new("TextButton")
openBtn.Size = UDim2.new(0, 56, 0, 56)
openBtn.Position = UDim2.new(1, -68, 0.08, 0)
openBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
openBtn.Text = "MENU"
openBtn.TextColor3 = Color3.fromRGB(255,255,255)
openBtn.TextSize = 12
openBtn.Font = Enum.Font.GothamBold
openBtn.AutoButtonColor = true
openBtn.Parent = gui
Instance.new("UICorner", openBtn).CornerRadius = UDim.new(1, 0)

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0.92, 0, 0.75, 0)
frame.Position = UDim2.new(0.04, 0, 0.12, 0)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
frame.Visible = false
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -44, 0, 36)
title.Position = UDim2.new(0, 10, 0, 4)
title.BackgroundTransparency = 1
title.Text = "MENU"
title.TextColor3 = Color3.fromRGB(0, 180, 255)
title.TextSize = 18
title.Font = Enum.Font.GothamBold
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = frame

local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 32, 0, 32)
closeBtn.Position = UDim2.new(1, -38, 0, 4)
closeBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
closeBtn.Text = "X"
closeBtn.TextColor3 = Color3.fromRGB(255,255,255)
closeBtn.TextSize = 16
closeBtn.Font = Enum.Font.GothamBold
closeBtn.Parent = frame
Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 8)

local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.new(1, -12, 1, -60)
scroll.Position = UDim2.new(0, 6, 0, 42)
scroll.BackgroundTransparency = 1
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 6
scroll.CanvasSize = UDim2.new(0, 0, 0, 560)
scroll.Parent = frame

local y = 0
local function nextY(h)
	local cur = y
	y = y + h + 8
	return cur
end

local function addText(txt, color)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, -8, 0, 18)
	l.Position = UDim2.new(0, 4, 0, nextY(18))
	l.BackgroundTransparency = 1
	l.Text = txt
	l.TextColor3 = color
	l.TextSize = 13
	l.Font = Enum.Font.GothamBold
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = scroll
	return l
end

local function addBtn(txt, color, h)
	h = h or 36
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -8, 0, h)
	b.Position = UDim2.new(0, 4, 0, nextY(h))
	b.BackgroundColor3 = color
	b.Text = txt
	b.TextColor3 = Color3.fromRGB(255,255,255)
	b.TextSize = 14
	b.Font = Enum.Font.GothamBold
	b.AutoButtonColor = true
	b.Parent = scroll
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
	return b
end

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, 0, 0, 16)
status.Position = UDim2.new(0, 0, 1, -18)
status.BackgroundTransparency = 1
status.Text = "Bấm MENU để mở"
status.TextColor3 = Color3.fromRGB(160, 160, 170)
status.TextSize = 11
status.Font = Enum.Font.Gotham
status.Parent = frame

-- SPEED
addText("— SPEED —", Color3.fromRGB(100, 220, 120))
local speedBtn = addBtn("Speed: OFF", Color3.fromRGB(55, 55, 65))

local speedLabel = Instance.new("TextLabel")
speedLabel.Size = UDim2.new(1, -8, 0, 18)
speedLabel.Position = UDim2.new(0, 4, 0, nextY(18))
speedLabel.BackgroundTransparency = 1
speedLabel.Text = "Speed: 16  (kéo thanh)"
speedLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
speedLabel.TextSize = 12
speedLabel.Font = Enum.Font.Gotham
speedLabel.Parent = scroll

local sliderBg = Instance.new("Frame")
sliderBg.Size = UDim2.new(1, -8, 0, 22)
sliderBg.Position = UDim2.new(0, 4, 0, nextY(22))
sliderBg.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
sliderBg.Parent = scroll
Instance.new("UICorner", sliderBg).CornerRadius = UDim.new(1, 0)

local sliderFill = Instance.new("Frame")
sliderFill.Size = UDim2.new((16-1)/199, 0, 1, 0)
sliderFill.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
sliderFill.Parent = sliderBg
Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(1, 0)

local dragging = false
local function setSpeedFromX(x)
	local a = math.clamp((x - sliderBg.AbsolutePosition.X) / math.max(sliderBg.AbsoluteSize.X, 1), 0, 1)
	speedValue = math.floor(1 + a * 199)
	sliderFill.Size = UDim2.new(a, 0, 1, 0)
	speedLabel.Text = "Speed: " .. speedValue .. "  (kéo thanh)"
end

sliderBg.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		setSpeedFromX(i.Position.X)
	end
end)
UIS.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)
UIS.InputChanged:Connect(function(i)
	if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
		setSpeedFromX(i.Position.X)
	end
end)

speedBtn.Activated:Connect(function()
	speedOn = not speedOn
	speedBtn.Text = speedOn and "Speed: ON" or "Speed: OFF"
	speedBtn.BackgroundColor3 = speedOn and Color3.fromRGB(0, 170, 100) or Color3.fromRGB(55, 55, 65)
	if not speedOn then
		local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if h then h.WalkSpeed = 16 end
	end
	status.Text = speedOn and ("Speed " .. speedValue) or "Speed tắt"
end)

-- FLOAT
addText("— SÀN FLOAT —", Color3.fromRGB(100, 180, 255))
local coordLabel = Instance.new("TextLabel")
coordLabel.Size = UDim2.new(1, -8, 0, 24)
coordLabel.Position = UDim2.new(0, 4, 0, nextY(24))
coordLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
coordLabel.Text = "Chưa lưu sàn Y"
coordLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
coordLabel.TextSize = 12
coordLabel.Font = Enum.Font.Gotham
coordLabel.Parent = scroll
Instance.new("UICorner", coordLabel).CornerRadius = UDim.new(0, 6)

local saveBtn = addBtn("Lưu sàn Y", Color3.fromRGB(0, 130, 210))
local floorBtn = addBtn("Sàn: OFF", Color3.fromRGB(55, 55, 65))

-- AIM
addText("— AIMBOT —", Color3.fromRGB(255, 120, 80))
local targetLabel = Instance.new("TextLabel")
targetLabel.Size = UDim2.new(1, -8, 0, 22)
targetLabel.Position = UDim2.new(0, 4, 0, nextY(22))
targetLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
targetLabel.Text = "Aim: Chưa chọn"
targetLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
targetLabel.TextSize = 12
targetLabel.Font = Enum.Font.Gotham
targetLabel.Parent = scroll
Instance.new("UICorner", targetLabel).CornerRadius = UDim.new(0, 6)

local aimBtn = addBtn("Aim: OFF", Color3.fromRGB(55, 55, 65))
local refreshAimBtn = addBtn("Làm mới DS Aim", Color3.fromRGB(0, 130, 200))

local aimList = Instance.new("ScrollingFrame")
aimList.Size = UDim2.new(1, -8, 0, 70)
aimList.Position = UDim2.new(0, 4, 0, nextY(70))
aimList.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
aimList.BorderSizePixel = 0
aimList.ScrollBarThickness = 4
aimList.Parent = scroll
Instance.new("UICorner", aimList).CornerRadius = UDim.new(0, 7)
Instance.new("UIListLayout", aimList).Padding = UDim.new(0, 3)

-- TP
addText("— TELEPORT —", Color3.fromRGB(220, 180, 80))
local tpLabel = Instance.new("TextLabel")
tpLabel.Size = UDim2.new(1, -8, 0, 22)
tpLabel.Position = UDim2.new(0, 4, 0, nextY(22))
tpLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
tpLabel.Text = "TP: Chưa chọn"
tpLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
tpLabel.TextSize = 12
tpLabel.Font = Enum.Font.Gotham
tpLabel.Parent = scroll
Instance.new("UICorner", tpLabel).CornerRadius = UDim.new(0, 6)

local tpBtn = addBtn("TP SAU LƯNG", Color3.fromRGB(200, 140, 30))
local refreshTpBtn = addBtn("Làm mới DS TP", Color3.fromRGB(0, 130, 200))

local tpList = Instance.new("ScrollingFrame")
tpList.Size = UDim2.new(1, -8, 0, 70)
tpList.Position = UDim2.new(0, 4, 0, nextY(70))
tpList.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
tpList.BorderSizePixel = 0
tpList.ScrollBarThickness = 4
tpList.Parent = scroll
Instance.new("UICorner", tpList).CornerRadius = UDim.new(0, 7)
Instance.new("UIListLayout", tpList).Padding = UDim.new(0, 3)

scroll.CanvasSize = UDim2.new(0, 0, 0, y + 20)

local function getRoot(c)
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function destroyFloor()
	if floorPart then pcall(function() floorPart:Destroy() end) floorPart = nil end
end

local function createFloor()
	if not savedY then return end
	destroyFloor()
	local r = getRoot(player.Character)
	local x, z = 0, 0
	if r then x, z = r.Position.X, r.Position.Z end
	floorPart = Instance.new("Part")
	floorPart.Name = "FloatFloor"
	floorPart.Size = Vector3.new(12, 1, 12)
	floorPart.Position = Vector3.new(x, savedY - 3.5, z)
	floorPart.Anchored = true
	floorPart.CanCollide = true
	floorPart.Transparency = 0.35
	floorPart.Color = Color3.fromRGB(0, 160, 255)
	floorPart.Material = Enum.Material.ForceField
	floorPart.Parent = workspace
end

local function fillList(list, isAim)
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
	local h = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr \~= player then
			local sel = (isAim and selectedTarget == plr) or (not isAim and tpTarget == plr)
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(1, -6, 0, 26)
			b.BackgroundColor3 = sel and Color3.fromRGB(0, 150, 90) or Color3.fromRGB(45, 45, 55)
			b.Text = plr.Name
			b.TextColor3 = Color3.fromRGB(240, 240, 240)
			b.TextSize = 13
			b.Font = Enum.Font.Gotham
			b.AutoButtonColor = true
			b.Parent = list
			Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
			b.Activated:Connect(function()
				if isAim then
					selectedTarget = plr
					targetLabel.Text = "Aim: " .. plr.Name
					fillList(aimList, true)
				else
					tpTarget = plr
					tpLabel.Text = "TP: " .. plr.Name
					fillList(tpList, false)
				end
				status.Text = (isAim and "Aim → " or "TP → ") .. plr.Name
			end)
			h = h + 29
		end
	end
	list.CanvasSize = UDim2.new(0, 0, 0, h)
end

saveBtn.Activated:Connect(function()
	local r = getRoot(player.Character)
	if not r then status.Text = "Không có nhân vật" return end
	savedY = r.Position.Y
	coordLabel.Text = string.format("Sàn Y: %.1f", savedY)
	status.Text = "Đã lưu sàn"
	if floorOn then createFloor() end
end)

floorBtn.Activated:Connect(function()
	if not savedY then status.Text = "Chưa lưu sàn!" return end
	floorOn = not floorOn
	floorBtn.Text = floorOn and "Sàn: ON" or "Sàn: OFF"
	floorBtn.BackgroundColor3 = floorOn and Color3.fromRGB(0, 170, 100) or Color3.fromRGB(55, 55, 65)
	if floorOn then createFloor() else destroyFloor() end
end)

aimBtn.Activated:Connect(function()
	if not selectedTarget then status.Text = "Chưa chọn Aim!" return end
	aimOn = not aimOn
	aimBtn.Text = aimOn and "Aim: ON" or "Aim: OFF"
	aimBtn.BackgroundColor3 = aimOn and Color3.fromRGB(0, 170, 100) or Color3.fromRGB(55, 55, 65)
end)

tpBtn.Activated:Connect(function()
	if not tpTarget then status.Text = "Chưa chọn TP!" return end
	local myR = getRoot(player.Character)
	local tR = getRoot(tpTarget.Character)
	if not myR or not tR then status.Text = "Không thấy nhân vật" return end
	local behind = tR.CFrame * CFrame.new(0, 0, 3.5)
	myR.CFrame = CFrame.lookAt(behind.Position, tR.Position)
	status.Text = "TP sau lưng " .. tpTarget.Name
end)

refreshAimBtn.Activated:Connect(function() fillList(aimList, true) end)
refreshTpBtn.Activated:Connect(function() fillList(tpList, false) end)

openBtn.Activated:Connect(function()
	frame.Visible = not frame.Visible
	if frame.Visible then
		fillList(aimList, true)
		fillList(tpList, false)
		status.Text = "Menu mở"
	end
end)

closeBtn.Activated:Connect(function()
	frame.Visible = false
end)

RunService.Heartbeat:Connect(function()
	local char = player.Character
	local myR = getRoot(char)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if speedOn and hum then hum.WalkSpeed = speedValue end
	if floorOn and savedY and floorPart and myR then
		floorPart.Position = Vector3.new(myR.Position.X, savedY - 3.5, myR.Position.Z)
	end
	if aimOn and selectedTarget and myR then
		local tR = getRoot(selectedTarget.Character)
		local tH = selectedTarget.Character and selectedTarget.Character:FindFirstChildOfClass("Humanoid")
		if tR and tH and tH.Health > 0 then
			myR.CFrame = CFrame.lookAt(myR.Position, Vector3.new(tR.Position.X, myR.Position.Y, tR.Position.Z))
		end
	end
end)

player.CharacterAdded:Connect(function(char)
	task.wait(0.5)
	if floorOn and savedY then createFloor() end
	if speedOn then
		local h = char:WaitForChild("Humanoid", 5)
		if h then h.WalkSpeed = speedValue end
	end
end)

print("MENU mobile Activated OK")
]])()
