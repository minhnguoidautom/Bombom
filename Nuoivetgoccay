loadstring([[
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")

pcall(function()
	if pg:FindFirstChild("FloatAimSpeedTP") then
		pg.FloatAimSpeedTP:Destroy()
	end
end)

local savedY, floorOn, floorPart = nil, false, nil
local aimOn, selectedTarget = false, nil
local speedOn, speedValue = false, 16
local tpTarget = nil

local gui = Instance.new("ScreenGui")
gui.Name = "FloatAimSpeedTP"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 999
gui.Parent = pg

local openBtn = Instance.new("TextButton")
openBtn.Size = UDim2.new(0, 42, 0, 42)
openBtn.Position = UDim2.new(1, -50, 0.15, 0)
openBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
openBtn.Text = "M"
openBtn.TextColor3 = Color3.fromRGB(255,255,255)
openBtn.TextSize = 14
openBtn.Font = Enum.Font.GothamBold
openBtn.Parent = gui
Instance.new("UICorner", openBtn).CornerRadius = UDim.new(1, 0)

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 200, 0, 280)
frame.Position = UDim2.new(1, -210, 0.12, 0)
frame.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
frame.Visible = false
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

-- Thanh kéo GUI
local dragBar = Instance.new("TextButton")
dragBar.Size = UDim2.new(1, -28, 0, 24)
dragBar.Position = UDim2.new(0, 0, 0, 0)
dragBar.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
dragBar.Text = "≡  MENU  (kéo)"
dragBar.TextColor3 = Color3.fromRGB(0, 180, 255)
dragBar.TextSize = 11
dragBar.Font = Enum.Font.GothamBold
dragBar.AutoButtonColor = false
dragBar.Parent = frame
Instance.new("UICorner", dragBar).CornerRadius = UDim.new(0, 10)

local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 22, 0, 22)
closeBtn.Position = UDim2.new(1, -25, 0, 1)
closeBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
closeBtn.Text = "X"
closeBtn.TextColor3 = Color3.fromRGB(255,255,255)
closeBtn.TextSize = 11
closeBtn.Font = Enum.Font.GothamBold
closeBtn.Parent = frame
Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 5)

-- Kéo frame
local fDrag, fStart, fPos = false, nil, nil
dragBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		fDrag = true
		fStart = input.Position
		fPos = frame.Position
	end
end)
UIS.InputChanged:Connect(function(input)
	if not fDrag then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		local d = input.Position - fStart
		frame.Position = UDim2.new(fPos.X.Scale, fPos.X.Offset + d.X, fPos.Y.Scale, fPos.Y.Offset + d.Y)
	end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		fDrag = false
	end
end)

-- Kéo nút M
local bDrag, bStart, bPos, bMoved = false, nil, nil, false
openBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		bDrag = true
		bMoved = false
		bStart = input.Position
		bPos = openBtn.Position
	end
end)
UIS.InputChanged:Connect(function(input)
	if not bDrag then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		local d = input.Position - bStart
		if math.abs(d.X) > 5 or math.abs(d.Y) > 5 then bMoved = true end
		openBtn.Position = UDim2.new(bPos.X.Scale, bPos.X.Offset + d.X, bPos.Y.Scale, bPos.Y.Offset + d.Y)
	end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		bDrag = false
	end
end)

local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.new(1, -8, 1, -42)
scroll.Position = UDim2.new(0, 4, 0, 26)
scroll.BackgroundTransparency = 1
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 3
scroll.CanvasSize = UDim2.new(0, 0, 0, 380)
scroll.Parent = frame

local y = 0
local function ny(h) local c = y y = y + h + 4 return c end
local function txt(t, col)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, -4, 0, 12)
	l.Position = UDim2.new(0, 2, 0, ny(12))
	l.BackgroundTransparency = 1
	l.Text = t
	l.TextColor3 = col
	l.TextSize = 9
	l.Font = Enum.Font.GothamBold
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = scroll
end
local function btn(t, col, h)
	h = h or 22
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -4, 0, h)
	b.Position = UDim2.new(0, 2, 0, ny(h))
	b.BackgroundColor3 = col
	b.Text = t
	b.TextColor3 = Color3.fromRGB(255,255,255)
	b.TextSize = 10
	b.Font = Enum.Font.GothamBold
	b.Parent = scroll
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)
	return b
end

txt("SPEED", Color3.fromRGB(100, 220, 120))
local speedBtn = btn("Speed: OFF", Color3.fromRGB(55, 55, 65))
local speedLabel = Instance.new("TextLabel")
speedLabel.Size = UDim2.new(1, -4, 0, 12)
speedLabel.Position = UDim2.new(0, 2, 0, ny(12))
speedLabel.BackgroundTransparency = 1
speedLabel.Text = "16"
speedLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
speedLabel.TextSize = 10
speedLabel.Font = Enum.Font.Gotham
speedLabel.Parent = scroll

local sliderBg = Instance.new("Frame")
sliderBg.Size = UDim2.new(1, -4, 0, 12)
sliderBg.Position = UDim2.new(0, 2, 0, ny(12))
sliderBg.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
sliderBg.Parent = scroll
Instance.new("UICorner", sliderBg).CornerRadius = UDim.new(1, 0)
local sliderFill = Instance.new("Frame")
sliderFill.Size = UDim2.new((16-1)/199, 0, 1, 0)
sliderFill.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
sliderFill.Parent = sliderBg
Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(1, 0)

local sDrag = false
local function setSpeedFromX(x)
	local a = math.clamp((x - sliderBg.AbsolutePosition.X) / math.max(sliderBg.AbsoluteSize.X, 1), 0, 1)
	speedValue = math.floor(1 + a * 199)
	sliderFill.Size = UDim2.new(a, 0, 1, 0)
	speedLabel.Text = tostring(speedValue)
end
sliderBg.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		sDrag = true
		setSpeedFromX(i.Position.X)
	end
end)
UIS.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		sDrag = false
	end
end)
UIS.InputChanged:Connect(function(i)
	if sDrag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
		setSpeedFromX(i.Position.X)
	end
end)

speedBtn.Activated:Connect(function()
	speedOn = not speedOn
	speedBtn.Text = speedOn and "Speed: ON" or "Speed: OFF"
	speedBtn.BackgroundColor3 = speedOn and Color3.fromRGB(0, 170, 100) or Color3.fromRGB(55, 55, 65)
	if not speedOn then
		local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if h then h.WalkSpeed = 16 end
	end
end)

txt("SÀN FLOAT", Color3.fromRGB(100, 180, 255))
local coordLabel = Instance.new("TextLabel")
coordLabel.Size = UDim2.new(1, -4, 0, 14)
coordLabel.Position = UDim2.new(0, 2, 0, ny(14))
coordLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
coordLabel.Text = "Chưa lưu Y"
coordLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
coordLabel.TextSize = 9
coordLabel.Font = Enum.Font.Gotham
coordLabel.Parent = scroll
Instance.new("UICorner", coordLabel).CornerRadius = UDim.new(0, 4)
local saveBtn = btn("Lưu Y", Color3.fromRGB(0, 130, 210))
local floorBtn = btn("Sàn: OFF", Color3.fromRGB(55, 55, 65))

txt("AIMBOT", Color3.fromRGB(255, 120, 80))
local targetLabel = Instance.new("TextLabel")
targetLabel.Size = UDim2.new(1, -4, 0, 14)
targetLabel.Position = UDim2.new(0, 2, 0, ny(14))
targetLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
targetLabel.Text = "Aim: —"
targetLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
targetLabel.TextSize = 9
targetLabel.Font = Enum.Font.Gotham
targetLabel.Parent = scroll
Instance.new("UICorner", targetLabel).CornerRadius = UDim.new(0, 4)
local aimBtn = btn("Aim: OFF", Color3.fromRGB(55, 55, 65))
local refreshAimBtn = btn("DS Aim", Color3.fromRGB(0, 130, 200))
local aimList = Instance.new("ScrollingFrame")
aimList.Size = UDim2.new(1, -4, 0, 48)
aimList.Position = UDim2.new(0, 2, 0, ny(48))
aimList.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
aimList.BorderSizePixel = 0
aimList.ScrollBarThickness = 3
aimList.Parent = scroll
Instance.new("UICorner", aimList).CornerRadius = UDim.new(0, 5)
Instance.new("UIListLayout", aimList).Padding = UDim.new(0, 2)

txt("TP", Color3.fromRGB(220, 180, 80))
local tpLabel = Instance.new("TextLabel")
tpLabel.Size = UDim2.new(1, -4, 0, 14)
tpLabel.Position = UDim2.new(0, 2, 0, ny(14))
tpLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
tpLabel.Text = "TP: —"
tpLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
tpLabel.TextSize = 9
tpLabel.Font = Enum.Font.Gotham
tpLabel.Parent = scroll
Instance.new("UICorner", tpLabel).CornerRadius = UDim.new(0, 4)
local tpBtn = btn("TP sau lưng", Color3.fromRGB(200, 140, 30))
local refreshTpBtn = btn("DS TP", Color3.fromRGB(0, 130, 200))
local tpList = Instance.new("ScrollingFrame")
tpList.Size = UDim2.new(1, -4, 0, 48)
tpList.Position = UDim2.new(0, 2, 0, ny(48))
tpList.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
tpList.BorderSizePixel = 0
tpList.ScrollBarThickness = 3
tpList.Parent = scroll
Instance.new("UICorner", tpList).CornerRadius = UDim.new(0, 5)
Instance.new("UIListLayout", tpList).Padding = UDim.new(0, 2)

scroll.CanvasSize = UDim2.new(0, 0, 0, y + 8)

local function getRoot(c) return c and c:FindFirstChild("HumanoidRootPart") end
local function destroyFloor()
	if floorPart then pcall(function() floorPart:Destroy() end) floorPart = nil end
end
local function createFloor()
	if not savedY then return end
	destroyFloor()
	local r = getRoot(player.Character)
	local x, z = 0, 0
	if r then x, z = r.Position.X, r.Position.Z end
	floorPart = Instance.new("Part")
	floorPart.Name = "FloatFloor"
	floorPart.Size = Vector3.new(12, 1, 12)
	floorPart.Position = Vector3.new(x, savedY - 3.5, z)
	floorPart.Anchored = true
	floorPart.CanCollide = true
	floorPart.Transparency = 0.35
	floorPart.Color = Color3.fromRGB(0, 160, 255)
	floorPart.Material = Enum.Material.ForceField
	floorPart.Parent = workspace
end

local function fillList(list, isAim)
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
	local h = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr \~= player then
			local sel = (isAim and selectedTarget == plr) or (not isAim and tpTarget == plr)
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(1, -4, 0, 18)
			b.BackgroundColor3 = sel and Color3.fromRGB(0, 150, 90) or Color3.fromRGB(45, 45, 55)
			b.Text = plr.Name
			b.TextColor3 = Color3.fromRGB(240, 240, 240)
			b.TextSize = 9
			b.Font = Enum.Font.Gotham
			b.Parent = list
			Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
			b.Activated:Connect(function()
				if isAim then
					selectedTarget = plr
					targetLabel.Text = "Aim: " .. plr.Name
					fillList(aimList, true)
				else
					tpTarget = plr
					tpLabel.Text = "TP: " .. plr.Name
					fillList(tpList, false)
				end
			end)
			h = h + 20
		end
	end
	list.CanvasSize = UDim2.new(0, 0, 0, h)
end

saveBtn.Activated:Connect(function()
	local r = getRoot(player.Character)
	if not r then return end
	savedY = r.Position.Y
	coordLabel.Text = string.format("Y: %.0f", savedY)
	if floorOn then createFloor() end
end)
floorBtn.Activated:Connect(function()
	if not savedY then return end
	floorOn = not floorOn
	floorBtn.Text = floorOn and "Sàn: ON" or "Sàn: OFF"
	floorBtn.BackgroundColor3 = floorOn and Color3.fromRGB(0, 170, 100) or Color3.fromRGB(55, 55, 65)
	if floorOn then createFloor() else destroyFloor() end
end)
aimBtn.Activated:Connect(function()
	if not selectedTarget then return end
	aimOn = not aimOn
	aimBtn.Text = aimOn and "Aim: ON" or "Aim: OFF"
	aimBtn.BackgroundColor3 = aimOn and Color3.fromRGB(0, 170, 100) or Color3.fromRGB(55, 55, 65)
end)
tpBtn.Activated:Connect(function()
	if not tpTarget then return end
	local myR = getRoot(player.Character)
	local tR = getRoot(tpTarget.Character)
	if not myR or not tR then return end
	local behind = tR.CFrame * CFrame.new(0, 0, 3.5)
	myR.CFrame = CFrame.lookAt(behind.Position, tR.Position)
end)
refreshAimBtn.Activated:Connect(function() fillList(aimList, true) end)
refreshTpBtn.Activated:Connect(function() fillList(tpList, false) end)

openBtn.Activated:Connect(function()
	if bMoved then return end
	frame.Visible = not frame.Visible
	if frame.Visible then
		fillList(aimList, true)
		fillList(tpList, false)
	end
end)
closeBtn.Activated:Connect(function() frame.Visible = false end)

RunService.Heartbeat:Connect(function()
	local char = player.Character
	local myR = getRoot(char)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if speedOn and hum then hum.WalkSpeed = speedValue end
	if floorOn and savedY and floorPart and myR then
		floorPart.Position = Vector3.new(myR.Position.X, savedY - 3.5, myR.Position.Z)
	end
	if aimOn and selectedTarget and myR then
		local tR = getRoot(selectedTarget.Character)
		local tH = selectedTarget.Character and selectedTarget.Character:FindFirstChildOfClass("Humanoid")
		if tR and tH and tH.Health > 0 then
			myR.CFrame = CFrame.lookAt(myR.Position, Vector3.new(tR.Position.X, myR.Position.Y, tR.Position.Z))
		end
	end
end)

player.CharacterAdded:Connect(function(char)
	task.wait(0.5)
	if floorOn and savedY then createFloor() end
	if speedOn then
		local h = char:WaitForChild("Humanoid", 5)
		if h then h.WalkSpeed = speedValue end
	end
end)

print("GUI keo duoc")
]])()
