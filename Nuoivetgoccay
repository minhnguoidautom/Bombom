loadstring([[
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")

pcall(function()
	if pg:FindFirstChild("FloatAimSpeedTP") then
		pg.FloatAimSpeedTP:Destroy()
	end
end)

local savedY, floorOn, floorPart = nil, false, nil
local aimOn, selectedTarget = false, nil
local speedOn, speedValue = false, 16
local tpTarget = nil

local gui = Instance.new("ScreenGui")
gui.Name = "FloatAimSpeedTP"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = pg

-- Nút MENU: góc trên phải, tránh nút Nhảy
local openBtn = Instance.new("TextButton")
openBtn.Size = UDim2.new(0, 52, 0, 52)
openBtn.Position = UDim2.new(1, -62, 0.12, 0)
openBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
openBtn.Text = "MENU"
openBtn.TextColor3 = Color3.fromRGB(255,255,255)
openBtn.TextSize = 11
openBtn.Font = Enum.Font.GothamBold
openBtn.ZIndex = 100
openBtn.Parent = gui
Instance.new("UICorner", openBtn).CornerRadius = UDim.new(1, 0)

-- Panel nhỏ hơn + cuộn
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 280, 0, 420)
frame.Position = UDim2.new(0.5, -140, 0.5, -210)
frame.BackgroundColor3 = Color3.fromRGB(16, 16, 22)
frame.Visible = false
frame.ZIndex = 100
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -40, 0, 32)
title.Position = UDim2.new(0, 8, 0, 4)
title.BackgroundTransparency = 1
title.Text = "FLOAT · AIM · SPEED · TP"
title.TextColor3 = Color3.fromRGB(0, 180, 255)
title.TextSize = 14
title.Font = Enum.Font.GothamBold
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = frame

local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 28, 0, 28)
closeBtn.Position = UDim2.new(1, -34, 0, 4)
closeBtn.BackgroundColor3 = Color3.fromRGB(200, 45, 45)
closeBtn.Text = "X"
closeBtn.TextColor3 = Color3.fromRGB(255,255,255)
closeBtn.TextSize = 14
closeBtn.Font = Enum.Font.GothamBold
closeBtn.Parent = frame
Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 7)

local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.new(1, -12, 1, -56)
scroll.Position = UDim2.new(0, 6, 0, 36)
scroll.BackgroundTransparency = 1
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 5
scroll.CanvasSize = UDim2.new(0, 0, 0, 520)
scroll.Parent = frame

local holder = Instance.new("Frame")
holder.Size = UDim2.new(1, -8, 0, 520)
holder.BackgroundTransparency = 1
holder.Parent = scroll

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, 0, 0, 16)
status.Position = UDim2.new(0, 0, 1, -18)
status.BackgroundTransparency = 1
status.Text = "Sẵn sàng"
status.TextColor3 = Color3.fromRGB(150, 150, 160)
status.TextSize = 11
status.Font = Enum.Font.Gotham
status.Parent = frame

local function makeLabel(parent, text, y, color)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 0, 16)
	l.Position = UDim2.new(0, 0, 0, y)
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = color
	l.TextSize = 11
	l.Font = Enum.Font.GothamBold
	l.Parent = parent
	return l
end

local function makeBtn(parent, text, y, h, color)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -4, 0, h or 28)
	b.Position = UDim2.new(0, 2, 0, y)
	b.BackgroundColor3 = color or Color3.fromRGB(55, 55, 65)
	b.Text = text
	b.TextColor3 = Color3.fromRGB(255,255,255)
	b.TextSize = 12
	b.Font = Enum.Font.GothamBold
	b.Parent = parent
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
	return b
end

-- SPEED
makeLabel(holder, "— SPEED —", 0, Color3.fromRGB(100, 220, 120))
local speedBtn = makeBtn(holder, "Speed: OFF", 20, 28, Color3.fromRGB(55, 55, 65))

local speedValueLabel = Instance.new("TextLabel")
speedValueLabel.Size = UDim2.new(1, 0, 0, 16)
speedValueLabel.Position = UDim2.new(0, 0, 0, 52)
speedValueLabel.BackgroundTransparency = 1
speedValueLabel.Text = "Speed: 16"
speedValueLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
speedValueLabel.TextSize = 12
speedValueLabel.Font = Enum.Font.Gotham
speedValueLabel.Parent = holder

local sliderBg = Instance.new("Frame")
sliderBg.Size = UDim2.new(1, -4, 0, 16)
sliderBg.Position = UDim2.new(0, 2, 0, 72)
sliderBg.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
sliderBg.Parent = holder
Instance.new("UICorner", sliderBg).CornerRadius = UDim.new(1, 0)

local sliderFill = Instance.new("Frame")
sliderFill.Size = UDim2.new((16-1)/199, 0, 1, 0)
sliderFill.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
sliderFill.Parent = sliderBg
Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(1, 0)

local sliderKnob = Instance.new("Frame")
sliderKnob.Size = UDim2.new(0, 18, 0, 18)
sliderKnob.Position = UDim2.new((16-1)/199, -9, 0.5, -9)
sliderKnob.BackgroundColor3 = Color3.fromRGB(255,255,255)
sliderKnob.Parent = sliderBg
Instance.new("UICorner", sliderKnob).CornerRadius = UDim.new(1, 0)

local dragging = false
local function setSpeedFromX(x)
	local absPos = sliderBg.AbsolutePosition.X
	local absSize = math.max(sliderBg.AbsoluteSize.X, 1)
	local alpha = math.clamp((x - absPos) / absSize, 0, 1)
	speedValue = math.floor(1 + alpha * 199)
	sliderFill.Size = UDim2.new(alpha, 0, 1, 0)
	sliderKnob.Position = UDim2.new(alpha, -9, 0.5, -9)
	speedValueLabel.Text = "Speed: " .. speedValue
end

sliderBg.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		setSpeedFromX(input.Position.X)
	end
end)
sliderKnob.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
	end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)
UIS.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		setSpeedFromX(input.Position.X)
	end
end)

speedBtn.MouseButton1Click:Connect(function()
	speedOn = not speedOn
	speedBtn.Text = speedOn and "Speed: ON" or "Speed: OFF"
	speedBtn.BackgroundColor3 = speedOn and Color3.fromRGB(0, 170, 100) or Color3.fromRGB(55, 55, 65)
	if not speedOn then
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = 16 end
	end
	status.Text = speedOn and ("Speed " .. speedValue) or "Speed tắt"
end)

-- FLOAT
makeLabel(holder, "— SÀN FLOAT —", 100, Color3.fromRGB(100, 180, 255))
local coordLabel = Instance.new("TextLabel")
coordLabel.Size = UDim2.new(1, -4, 0, 22)
coordLabel.Position = UDim2.new(0, 2, 0, 120)
coordLabel.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
coordLabel.Text = "Chưa lưu sàn Y"
coordLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
coordLabel.TextSize = 11
coordLabel.Font = Enum.Font.Gotham
coordLabel.Parent = holder
Instance.new("UICorner", coordLabel).CornerRadius = UDim.new(0, 6)

local saveBtn = makeBtn(holder, "Lưu sàn Y", 148, 28, Color3.fromRGB(0, 130, 210))
saveBtn.Size = UDim2.new(0.48, 0, 0, 28)
local floorBtn = makeBtn(holder, "Sàn: OFF", 148, 28, Color3.fromRGB(55, 55, 65))
floorBtn.Size = UDim2.new(0.48, 0, 0, 28)
floorBtn.Position = UDim2.new(0.52, 0, 0, 148)

-- AIM
makeLabel(holder, "— AIMBOT —", 186, Color3.fromRGB(255, 120, 80))
local targetLabel = Instance.new("TextLabel")
targetLabel.Size = UDim2.new(1, -4, 0, 20)
targetLabel.Position = UDim2.new(0, 2, 0, 206)
targetLabel.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
targetLabel.Text = "Aim: Chưa chọn"
targetLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
targetLabel.TextSize = 11
targetLabel.Font = Enum.Font.Gotham
targetLabel.Parent = holder
Instance.new("UICorner", targetLabel).CornerRadius = UDim.new(0, 6)

local aimBtn = makeBtn(holder, "Aim: OFF", 232, 26, Color3.fromRGB(55, 55, 65))
aimBtn.Size = UDim2.new(0.48, 0, 0, 26)
local refreshAimBtn = makeBtn(holder, "DS Aim", 232, 26, Color3.fromRGB(0, 130, 200))
refreshAimBtn.Size = UDim2.new(0.48, 0, 0, 26)
refreshAimBtn.Position = UDim2.new(0.52, 0, 0, 232)

local aimList = Instance.new("ScrollingFrame")
aimList.Size = UDim2.new(1, -4, 0, 60)
aimList.Position = UDim2.new(0, 2, 0, 264)
aimList.BackgroundColor3 = Color3.fromRGB(26, 26, 34)
aimList.BorderSizePixel = 0
aimList.ScrollBarThickness = 4
aimList.Parent = holder
Instance.new("UICorner", aimList).CornerRadius = UDim.new(0, 7)
Instance.new("UIListLayout", aimList).Padding = UDim.new(0, 3)

-- TP
makeLabel(holder, "— TELEPORT —", 334, Color3.fromRGB(220, 180, 80))
local tpLabel = Instance.new("TextLabel")
tpLabel.Size = UDim2.new(1, -4, 0, 20)
tpLabel.Position = UDim2.new(0, 2, 0, 354)
tpLabel.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
tpLabel.Text = "TP: Chưa chọn"
tpLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
tpLabel.TextSize = 11
tpLabel.Font = Enum.Font.Gotham
tpLabel.Parent = holder
Instance.new("UICorner", tpLabel).CornerRadius = UDim.new(0, 6)

local tpBtn = makeBtn(holder, "TP SAU LƯNG", 380, 28, Color3.fromRGB(200, 140, 30))
tpBtn.Size = UDim2.new(0.48, 0, 0, 28)
local refreshTpBtn = makeBtn(holder, "DS TP", 380, 28, Color3.fromRGB(0, 130, 200))
refreshTpBtn.Size = UDim2.new(0.48, 0, 0, 28)
refreshTpBtn.Position = UDim2.new(0.52, 0, 0, 380)

local tpList = Instance.new("ScrollingFrame")
tpList.Size = UDim2.new(1, -4, 0, 60)
tpList.Position = UDim2.new(0, 2, 0, 414)
tpList.BackgroundColor3 = Color3.fromRGB(26, 26, 34)
tpList.BorderSizePixel = 0
tpList.ScrollBarThickness = 4
tpList.Parent = holder
Instance.new("UICorner", tpList).CornerRadius = UDim.new(0, 7)
Instance.new("UIListLayout", tpList).Padding = UDim.new(0, 3)

local function getRoot(char)
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function destroyFloor()
	if floorPart then pcall(function() floorPart:Destroy() end) floorPart = nil end
end

local function createFloor()
	if not savedY then return end
	destroyFloor()
	local root = getRoot(player.Character)
	local x, z = 0, 0
	if root then x, z = root.Position.X, root.Position.Z end
	floorPart = Instance.new("Part")
	floorPart.Name = "FloatFloor"
	floorPart.Size = Vector3.new(12, 1, 12)
	floorPart.Position = Vector3.new(x, savedY - 3.5, z)
	floorPart.Anchored = true
	floorPart.CanCollide = true
	floorPart.Transparency = 0.35
	floorPart.Color = Color3.fromRGB(0, 160, 255)
	floorPart.Material = Enum.Material.ForceField
	floorPart.Parent = workspace
end

local function fillList(list, isAim)
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
	local y = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr \~= player then
			local sel = isAim and selectedTarget == plr or (not isAim and tpTarget == plr)
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, -6, 0, 22)
			btn.BackgroundColor3 = sel and Color3.fromRGB(0, 150, 90) or Color3.fromRGB(42, 42, 52)
			btn.Text = plr.Name
			btn.TextColor3 = Color3.fromRGB(235, 235, 235)
			btn.TextSize = 11
			btn.Font = Enum.Font.Gotham
			btn.Parent = list
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
			btn.MouseButton1Click:Connect(function()
				if isAim then
					selectedTarget = plr
					targetLabel.Text = "Aim: " .. plr.Name
					fillList(aimList, true)
				else
					tpTarget = plr
					tpLabel.Text = "TP: " .. plr.Name
					fillList(tpList, false)
				end
				status.Text = (isAim and "Aim → " or "TP → ") .. plr.Name
			end)
			y = y + 25
		end
	end
	list.CanvasSize = UDim2.new(0, 0, 0, y)
end

saveBtn.MouseButton1Click:Connect(function()
	local root = getRoot(player.Character)
	if not root then status.Text = "Không có nhân vật" return end
	savedY = root.Position.Y
	coordLabel.Text = string.format("Sàn Y: %.1f", savedY)
	status.Text = "Đã lưu sàn"
	if floorOn then createFloor() end
end)

floorBtn.MouseButton1Click:Connect(function()
	if not savedY then status.Text = "Chưa lưu sàn!" return end
	floorOn = not floorOn
	floorBtn.Text = floorOn and "Sàn: ON" or "Sàn: OFF"
	floorBtn.BackgroundColor3 = floorOn and Color3.fromRGB(0, 170, 100) or Color3.fromRGB(55, 55, 65)
	if floorOn then createFloor() else destroyFloor() end
end)

aimBtn.MouseButton1Click:Connect(function()
	if not selectedTarget then status.Text = "Chưa chọn Aim!" return end
	aimOn = not aimOn
	aimBtn.Text = aimOn and "Aim: ON" or "Aim: OFF"
	aimBtn.BackgroundColor3 = aimOn and Color3.fromRGB(0, 170, 100) or Color3.fromRGB(55, 55, 65)
end)

tpBtn.MouseButton1Click:Connect(function()
	if not tpTarget then status.Text = "Chưa chọn TP!" return end
	local myRoot = getRoot(player.Character)
	local tRoot = getRoot(tpTarget.Character)
	if not myRoot or not tRoot then status.Text = "Không thấy nhân vật" return end
	local behind = tRoot.CFrame * CFrame.new(0, 0, 3.5)
	myRoot.CFrame = CFrame.lookAt(behind.Position, tRoot.Position)
	status.Text = "TP sau lưng " .. tpTarget.Name
end)

refreshAimBtn.MouseButton1Click:Connect(function() fillList(aimList, true) end)
refreshTpBtn.MouseButton1Click:Connect(function() fillList(tpList, false) end)

openBtn.MouseButton1Click:Connect(function()
	frame.Visible = not frame.Visible
	if frame.Visible then
		fillList(aimList, true)
		fillList(tpList, false)
	end
end)
closeBtn.MouseButton1Click:Connect(function() frame.Visible = false end)

RunService.Heartbeat:Connect(function()
	local char = player.Character
	local myRoot = getRoot(char)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if speedOn and hum then hum.WalkSpeed = speedValue end
	if floorOn and savedY and floorPart and myRoot then
		floorPart.Position = Vector3.new(myRoot.Position.X, savedY - 3.5, myRoot.Position.Z)
	end
	if aimOn and selectedTarget and myRoot then
		local tRoot = getRoot(selectedTarget.Character)
		local tHum = selectedTarget.Character and selectedTarget.Character:FindFirstChildOfClass("Humanoid")
		if tRoot and tHum and tHum.Health > 0 then
			myRoot.CFrame = CFrame.lookAt(myRoot.Position, Vector3.new(tRoot.Position.X, myRoot.Position.Y, tRoot.Position.Z))
		end
	end
end)

player.CharacterAdded:Connect(function(char)
	task.wait(0.5)
	if floorOn and savedY then createFloor() end
	if speedOn then
		local hum = char:WaitForChild("Humanoid", 5)
		if hum then hum.WalkSpeed = speedValue end
	end
end)

print("MENU mobile OK")
]])()
