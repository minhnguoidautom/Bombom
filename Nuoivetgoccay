local tpBtn = Instance.new("TextButton")
tpBtn.Size = UDim2.new(0.42, 0, 0, 28)
tpBtn.Position = UDim2.new(0.05, 0, 0.72, 0)
tpBtn.BackgroundColor3 = Color3.fromRGB(200, 140, 30)
