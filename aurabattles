        LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end

    -- Speed
    if States.Speed then
        hum.WalkSpeed = States.SpeedValue
    end

    -- Jump
    if States.Jump then
        hum.JumpPower = States.JumpValue
        hum.UseJumpPower = true
    end

    -- Noclip
    if States.Noclip then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    -- Spin Bot
    if States.SpinBot then
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(22), 0)
    end

    -- ====================== ANTI KNOCKBACK ======================
    if States.AntiKnockback then
        local anti = hrp:FindFirstChild("AntiKB")
        if not anti then
            anti = Instance.new("BodyVelocity")
            anti.Name = "AntiKB"
            anti.MaxForce = Vector3.new(120000, 0, 120000)
            anti.P = 4000
            anti.Parent = hrp
        end

        local power = (States.AntiKBPower or 8) / 10
        local vel = hrp.AssemblyLinearVelocity

        hrp.AssemblyLinearVelocity = Vector3.new(
            vel.X * (1 - power),
            vel.Y,
            vel.Z * (1 - power)
        )
        anti.Velocity = Vector3.new(0, 0, 0)
    else
        if hrp:FindFirstChild("AntiKB") then
            hrp.AntiKB:Destroy()
        end
    end

    -- ====================== FLOAT PLATFORM ======================
    if States.Float and States.FloatY then
        local platform = workspace:FindFirstChild("FloatPlatform")
        if not platform then
            platform = Instance.new("Part")
            platform.Name = "FloatPlatform"
            platform.Size = Vector3.new(8, 1, 8)
            platform.Anchored = true
            platform.CanCollide = true
            platform.Transparency = 0.35
            platform.Material = Enum.Material.Neon
            platform.Color = Color3.fromRGB(0, 170, 255)
            platform.TopSurface = Enum.SurfaceType.Smooth
            platform.Parent = workspace
        end

        local platformY = States.FloatY - States.FloatHeight
        platform.CFrame = CFrame.new(hrp.Position.X, platformY, hrp.Position.Z)

        -- Nếu bị tụt xuống dưới sàn hơn 1 stud → kéo lên
        if hrp.Position.Y < (platformY + 1) then
            hrp.CFrame = CFrame.new(
                hrp.Position.X,
                platformY + 3.2,
                hrp.Position.Z
            )
            hrp.AssemblyLinearVelocity = Vector3.new(
                hrp.AssemblyLinearVelocity.X,
                0,
                hrp.AssemblyLinearVelocity.Z
            )
        end
    else
        if workspace:FindFirstChild("FloatPlatform") then
            workspace.FloatPlatform:Destroy()
        end
    end

    -- ====================== NO COOLDOWN ======================
    if States.NoCooldown then
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                local name = string.lower(v.Name)
                if string.find(name, "cooldown") or string.find(name, "cd") or string.find(name, "delay") or string.find(name, "timer") then
                    v.Value = 0
                end
            end
        end

        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            for _, v in pairs(playerGui:GetDescendants()) do
                if v:IsA("NumberValue") or v:IsA("IntValue") then
                    local name = string.lower(v.Name)
                    if string.find(name, "cooldown") or string.find(name, "cd") or string.find(name, "delay") then
                        v.Value = 0
                    end
                end
            end
        end
    end

    -- ====================== AIMCAM (Tự động xoay cam về mục tiêu) ======================
    if States.AimCam and States.SelectedTarget then
        local targetChar = States.SelectedTarget.Character
        if targetChar and targetChar:FindFirstChild("HumanoidRootPart") and targetChar:FindFirstChild("Humanoid") and targetChar.Humanoid.Health > 0 then
            local targetHRP = targetChar.HumanoidRootPart
            local targetPos = targetHRP.Position + Vector3.new(0, 1.5, 0)
            local camPos = Camera.CFrame.Position
            Camera.CFrame = CFrame.lookAt(camPos, targetPos)
        else
            States.AimCam = false
            Rayfield:Notify({
                Title = "AimCam",
                Content = "Mục tiêu đã mất, đã tắt AimCam",
                Duration = 2
            })
        end
    end
end)

