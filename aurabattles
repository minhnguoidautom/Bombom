LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.6)
    local hum = char:WaitForChild("Humanoid", 3)
    if hum then
        if States.Speed then hum.WalkSpeed = States.SpeedValue end
        if States.Jump then
            hum.JumpPower = States.JumpValue
            hum.UseJumpPower = true
        end
    end
end)

