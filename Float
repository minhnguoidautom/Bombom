loadstring([[
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")

pcall(function()
	if pg:FindFirstChild("FloorFloat") then
		pg.FloorFloat:Destroy()
	end
end)

local savedY = nil
local floatOn = false
local floorPart = nil

local gui = Instance.new("ScreenGui")
gui.Name = "FloorFloat"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = pg

local openBtn = Instance.new("TextButton")
openBtn.Size = UDim2.new(0, 58, 0, 58)
openBtn.Position = UDim2.new(1, -72, 0.35, 0)
openBtn.BackgroundColor3 = Color3.fromRGB(0, 160, 255)
openBtn.Text = "FLOAT"
openBtn.TextColor3 = Color3.fromRGB(255,255,255)
openBtn.TextSize = 12
openBtn.Font = Enum.Font.GothamBold
openBtn.Parent = gui
Instance.new("UICorner", openBtn).CornerRadius = UDim.new(1, 0)

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 270, 0, 280)
frame.Position = UDim2.new(0.5, -135, 0.5, -140)
frame.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
frame.Visible = false
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 13)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundTransparency = 1
title.Text = "SÀN FLOAT"
title.TextColor3 = Color3.fromRGB(0, 180, 255)
title.TextSize = 16
title.Font = Enum.Font.GothamBold
title.Parent = frame

local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 30, 0, 30)
closeBtn.Position = UDim2.new(1, -36, 0, 5)
closeBtn.BackgroundColor3 = Color3.fromRGB(200, 45, 45)
closeBtn.Text = "X"
closeBtn.TextColor3 = Color3.fromRGB(255,255,255)
closeBtn.TextSize = 14
closeBtn.Font = Enum.Font.GothamBold
closeBtn.Parent = frame
Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 7)

local coordLabel = Instance.new("TextLabel")
coordLabel.Size = UDim2.new(0.9, 0, 0, 40)
coordLabel.Position = UDim2.new(0.05, 0, 0.18, 0)
coordLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
coordLabel.Text = "Chưa lưu độ cao sàn"
coordLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
coordLabel.TextSize = 13
coordLabel.Font = Enum.Font.Gotham
coordLabel.Parent = frame
Instance.new("UICorner", coordLabel).CornerRadius = UDim.new(0, 8)

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, 0, 0, 20)
status.Position = UDim2.new(0, 0, 0.88, 0)
status.BackgroundTransparency = 1
status.Text = "Lưu Y → Bật sàn"
status.TextColor3 = Color3.fromRGB(150, 150, 160)
status.TextSize = 12
status.Font = Enum.Font.Gotham
status.Parent = frame

local saveBtn = Instance.new("TextButton")
saveBtn.Size = UDim2.new(0.86, 0, 0, 40)
saveBtn.Position = UDim2.new(0.07, 0, 0.38, 0)
saveBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 220)
saveBtn.Text = "LƯU ĐỘ CAO SÀN"
saveBtn.TextColor3 = Color3.fromRGB(255,255,255)
saveBtn.TextSize = 15
saveBtn.Font = Enum.Font.GothamBold
saveBtn.Parent = frame
Instance.new("UICorner", saveBtn).CornerRadius = UDim.new(0, 9)

local floatBtn = Instance.new("TextButton")
floatBtn.Size = UDim2.new(0.86, 0, 0, 40)
floatBtn.Position = UDim2.new(0.07, 0, 0.56, 0)
floatBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
floatBtn.Text = "SÀN : OFF"
floatBtn.TextColor3 = Color3.fromRGB(255,255,255)
floatBtn.TextSize = 15
floatBtn.Font = Enum.Font.GothamBold
floatBtn.Parent = frame
Instance.new("UICorner", floatBtn).CornerRadius = UDim.new(0, 9)

local clearBtn = Instance.new("TextButton")
clearBtn.Size = UDim2.new(0.86, 0, 0, 34)
clearBtn.Position = UDim2.new(0.07, 0, 0.73, 0)
clearBtn.BackgroundColor3 = Color3.fromRGB(90, 90, 100)
clearBtn.Text = "Xóa sàn"
clearBtn.TextColor3 = Color3.fromRGB(255,255,255)
clearBtn.TextSize = 13
clearBtn.Font = Enum.Font.Gotham
clearBtn.Parent = frame
Instance.new("UICorner", clearBtn).CornerRadius = UDim.new(0, 8)

local function getRoot()
	local char = player.Character
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart")
end

local function destroyFloor()
	if floorPart then
		pcall(function() floorPart:Destroy() end)
		floorPart = nil
	end
end

local function createFloor()
	if not savedY then return end
	destroyFloor()

	local root = getRoot()
	local x, z = 0, 0
	if root then
		x, z = root.Position.X, root.Position.Z
	end

	floorPart = Instance.new("Part")
	floorPart.Name = "FloatFloor"
	floorPart.Size = Vector3.new(22, 1, 22)   -- sàn rộng
	floorPart.Position = Vector3.new(x, savedY - 3.5, z)
	floorPart.Anchored = true
	floorPart.CanCollide = true                 -- đứng được
	floorPart.Transparency = 0.35
	floorPart.Color = Color3.fromRGB(0, 160, 255)
	floorPart.Material = Enum.Material.ForceField
	floorPart.Parent = workspace
end

saveBtn.MouseButton1Click:Connect(function()
	local root = getRoot()
	if not root then
		status.Text = "Không tìm thấy nhân vật"
		return
	end
	savedY = root.Position.Y
	coordLabel.Text = string.format("Sàn tại Y: %.1f", savedY)
	status.Text = "Đã lưu - Bật SÀN để tạo nền"
	if floatOn then
		createFloor()
	end
end)

floatBtn.MouseButton1Click:Connect(function()
	if not savedY then
		status.Text = "Chưa lưu độ cao sàn!"
		return
	end
	floatOn = not floatOn
	if floatOn then
		floatBtn.Text = "SÀN : ON"
		floatBtn.BackgroundColor3 = Color3.fromRGB(0, 175, 100)
		createFloor()
		status.Text = "Sàn đã bật - đứng lên được"
	else
		floatBtn.Text = "SÀN : OFF"
		floatBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
		destroyFloor()
		status.Text = "Đã tắt sàn"
	end
end)

clearBtn.MouseButton1Click:Connect(function()
	savedY = nil
	floatOn = false
	floatBtn.Text = "SÀN : OFF"
	floatBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
	coordLabel.Text = "Chưa lưu độ cao sàn"
	status.Text = "Đã xóa sàn"
	destroyFloor()
end)

openBtn.MouseButton1Click:Connect(function()
	frame.Visible = not frame.Visible
end)

closeBtn.MouseButton1Click:Connect(function()
	frame.Visible = false
end)

-- Sàn đi theo chân người chơi (cùng độ cao Y đã lưu)
RunService.Heartbeat:Connect(function()
	if not floatOn or not savedY or not floorPart then return end
	local root = getRoot()
	if not root then return end
	floorPart.Position = Vector3.new(root.Position.X, savedY - 3.5, root.Position.Z)
end)

player.CharacterAdded:Connect(function()
	task.wait(0.5)
	if floatOn and savedY then
		createFloor()
	end
end)

print("Floor Float Loaded")
]])()
