loadstring([[
-- ======================
-- PROJECT SMASH - BẢN ỔN ĐỊNH
-- ======================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local VIM = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui", 10)

-- Xóa GUI cũ
pcall(function()
	local old = pg:FindFirstChild("SmashStable")
	if old then old:Destroy() end
end)

-- ========== TẠO GUI TRƯỚC (quan trọng) ==========
local gui = Instance.new("ScreenGui")
gui.Name = "SmashStable"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = pg

-- Nút nổi (to, dễ thấy)
local openBtn = Instance.new("TextButton")
openBtn.Name = "Open"
openBtn.Size = UDim2.new(0, 70, 0, 70)
openBtn.Position = UDim2.new(1, -85, 0.25, 0)
openBtn.BackgroundColor3 = Color3.fromRGB(255, 40, 30)
openBtn.Text = "SMASH"
openBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
openBtn.TextSize = 15
openBtn.Font = Enum.Font.GothamBold
openBtn.Parent = gui

local c1 = Instance.new("UICorner")
c1.CornerRadius = UDim.new(1, 0)
c1.Parent = openBtn

-- Frame menu
local frame = Instance.new("Frame")
frame.Name = "Menu"
frame.Size = UDim2.new(0, 270, 0, 340)
frame.Position = UDim2.new(0.5, -135, 0.5, -170)
frame.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
frame.Visible = false
frame.Parent = gui

local c2 = Instance.new("UICorner")
c2.CornerRadius = UDim.new(0, 14)
c2.Parent = frame

-- Title
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 42)
title.BackgroundTransparency = 1
title.Text = "PROJECT SMASH"
title.TextColor3 = Color3.fromRGB(255, 70, 40)
title.TextSize = 19
title.Font = Enum.Font.GothamBold
title.Parent = frame

-- Nút X
local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 32, 0, 32)
closeBtn.Position = UDim2.new(1, -38, 0, 6)
closeBtn.BackgroundColor3 = Color3.fromRGB(200, 35, 35)
closeBtn.Text = "X"
closeBtn.TextColor3 = Color3.fromRGB(255,255,255)
closeBtn.TextSize = 16
closeBtn.Font = Enum.Font.GothamBold
closeBtn.Parent = frame

local c3 = Instance.new("UICorner")
c3.CornerRadius = UDim.new(0, 8)
c3.Parent = closeBtn

-- Status
local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, 0, 0, 22)
status.Position = UDim2.new(0, 0, 0.90, 0)
status.BackgroundTransparency = 1
status.Text = "Đã load - Bấm SMASH để mở"
status.TextColor3 = Color3.fromRGB(150, 150, 160)
status.TextSize = 12
status.Font = Enum.Font.Gotham
status.Parent = frame

-- ========== BIẾN ==========
local KillAura = false
local HitboxOn = true
local SpeedOn = true
local InfJump = true
local Range = 25
local HitboxSize = 46
local SpeedValue = 36
local Delay = 0.12
local lastHit = 0
local hitboxes = {}

-- ========== TẠO NÚT TOGGLE ==========
local function makeToggle(name, y, default, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.86, 0, 0, 40)
	btn.Position = UDim2.new(0.07, 0, y, 0)
	btn.BackgroundColor3 = default and Color3.fromRGB(0, 175, 90) or Color3.fromRGB(45, 45, 55)
	btn.Text = name .. (default and "  •  ON" or "  •  OFF")
	btn.TextColor3 = Color3.fromRGB(255,255,255)
	btn.TextSize = 15
	btn.Font = Enum.Font.GothamBold
	btn.Parent = frame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 9)
	corner.Parent = btn

	local on = default
	btn.MouseButton1Click:Connect(function()
		on = not on
		btn.Text = name .. (on and "  •  ON" or "  •  OFF")
		btn.BackgroundColor3 = on and Color3.fromRGB(0, 175, 90) or Color3.fromRGB(45, 45, 55)
		callback(on)
		status.Text = name .. (on and " đã BẬT" or " đã TẮT")
	end)
end

makeToggle("Kill Aura", 0.15, false, function(v) KillAura = v end)
makeToggle("Hitbox", 0.29, true, function(v) HitboxOn = v end)
makeToggle("Speed", 0.43, true, function(v) SpeedOn = v end)
makeToggle("Inf Jump", 0.57, true, function(v) InfJump = v end)

-- Nút Test
local testBtn = Instance.new("TextButton")
testBtn.Size = UDim2.new(0.86, 0, 0, 36)
testBtn.Position = UDim2.new(0.07, 0, 0.72, 0)
testBtn.BackgroundColor3 = Color3.fromRGB(0, 130, 210)
testBtn.Text = "TEST ĐÁNH"
testBtn.TextColor3 = Color3.fromRGB(255,255,255)
testBtn.TextSize = 14
testBtn.Font = Enum.Font.GothamBold
testBtn.Parent = frame

local c4 = Instance.new("UICorner")
c4.CornerRadius = UDim.new(0, 8)
c4.Parent = testBtn

testBtn.MouseButton1Click:Connect(function()
	pcall(function()
		VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
		task.wait(0.04)
		VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
	end)
	status.Text = "Đã test đánh"
end)

-- Mở / Đóng menu
openBtn.MouseButton1Click:Connect(function()
	frame.Visible = not frame.Visible
end)

closeBtn.MouseButton1Click:Connect(function()
	frame.Visible = false
end)

-- ========== CHỨC NĂNG ==========
local function addHitbox(char)
	if not char or hitboxes[char] then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local box = Instance.new("Part")
	box.Name = "SmashHB"
	box.Size = Vector3.new(HitboxSize, HitboxSize * 1.3, HitboxSize)
	box.Transparency = 0.65
	box.Color = Color3.fromRGB(255, 55, 30)
	box.Material = Enum.Material.ForceField
	box.CanCollide = false
	box.Massless = true
	box.Parent = char

	local weld = Instance.new("Weld")
	weld.Part0 = root
	weld.Part1 = box
	weld.C0 = CFrame.new(0, 0.4, 0)
	weld.Parent = box

	hitboxes[char] = box
end

-- Inf Jump
UIS.JumpRequest:Connect(function()
	if InfJump and player.Character then
		local hum = player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
end)

-- Main Loop
RunService.Heartbeat:Connect(function()
	local char = player.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return end

	-- Speed
	if SpeedOn then
		hum.WalkSpeed = SpeedValue
	end

	-- Hitbox
	if HitboxOn then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr \~= player and plr.Character then
				addHitbox(plr.Character)
			end
		end
	end

	-- Kill Aura
	if KillAura and (tick() - lastHit) > Delay then
		local closest = nil
		local closestDist = Range

		for _, plr in ipairs(Players:GetPlayers()) do
			if plr \~= player and plr.Character then
				local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
				local tHum = plr.Character:FindFirstChildOfClass("Humanoid")
				if tRoot and tHum and tHum.Health > 0 then
					local dist = (root.Position - tRoot.Position).Magnitude
					if dist < closestDist then
						closestDist = dist
						closest = tRoot
					end
				end
			end
		end

		if closest then
			lastHit = tick()
			root.CFrame = CFrame.lookAt(root.Position, Vector3.new(closest.Position.X, root.Position.Y, closest.Position.Z))
			pcall(function()
				VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
				task.wait(0.03)
				VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
			end)
			status.Text = "Đang đánh..."
		end
	end
end)

-- Giữ speed khi hồi sinh
player.CharacterAdded:Connect(function(char)
	task.wait(0.6)
	local hum = char:WaitForChild("Humanoid", 5)
	if hum and SpeedOn then
		hum.WalkSpeed = SpeedValue
	end
end)

print("=================================")
print("PROJECT SMASH LOADED")
print("Nút SMASH màu đỏ đã hiện góc phải")
print("=================================")
]])()
