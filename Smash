loadstring([[
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")

-- Xóa cũ
pcall(function()
	if pg:FindFirstChild("SmashOK") then pg.SmashOK:Destroy() end
end)

-- ===== Cài đặt =====
local KillAura = false
local HitboxOn = true
local SpeedOn = true
local InfJump = true

local Range = 24
local HitboxSize = 44
local SpeedValue = 35
local Delay = 0.12

local hitboxes = {}
local lastHit = 0

-- ===== GUI =====
local gui = Instance.new("ScreenGui")
gui.Name = "SmashOK"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = pg

local openBtn = Instance.new("TextButton")
openBtn.Size = UDim2.new(0, 62, 0, 62)
openBtn.Position = UDim2.new(1, -78, 0.28, 0)
openBtn.BackgroundColor3 = Color3.fromRGB(255, 55, 40)
openBtn.Text = "SMASH"
openBtn.TextColor3 = Color3.fromRGB(255,255,255)
openBtn.TextSize = 13
openBtn.Font = Enum.Font.GothamBold
openBtn.Parent = gui
Instance.new("UICorner", openBtn).CornerRadius = UDim.new(1, 0)

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 320)
frame.Position = UDim2.new(0.5, -130, 0.5, -160)
frame.BackgroundColor3 = Color3.fromRGB(16, 16, 22)
frame.Visible = false
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 13)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundTransparency = 1
title.Text = "PROJECT SMASH"
title.TextColor3 = Color3.fromRGB(255, 75, 45)
title.TextSize = 18
title.Font = Enum.Font.GothamBold
title.Parent = frame

local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 30, 0, 30)
closeBtn.Position = UDim2.new(1, -36, 0, 5)
closeBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
closeBtn.Text = "X"
closeBtn.TextColor3 = Color3.fromRGB(255,255,255)
closeBtn.TextSize = 15
closeBtn.Font = Enum.Font.GothamBold
closeBtn.Parent = frame
Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 7)

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, 0, 0, 22)
status.Position = UDim2.new(0, 0, 0.90, 0)
status.BackgroundTransparency = 1
status.Text = "Sẵn sàng"
status.TextColor3 = Color3.fromRGB(160,160,170)
status.TextSize = 13
status.Font = Enum.Font.Gotham
status.Parent = frame

local function createToggle(text, y, default, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.86, 0, 0, 38)
	btn.Position = UDim2.new(0.07, 0, y, 0)
	btn.BackgroundColor3 = default and Color3.fromRGB(0, 175, 90) or Color3.fromRGB(50, 50, 60)
	btn.Text = text .. (default and "  •  ON" or "  •  OFF")
	btn.TextColor3 = Color3.fromRGB(255,255,255)
	btn.TextSize = 15
	btn.Font = Enum.Font.GothamBold
	btn.Parent = frame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 9)

	local on = default
	btn.MouseButton1Click:Connect(function()
		on = not on
		btn.Text = text .. (on and "  •  ON" or "  •  OFF")
		btn.BackgroundColor3 = on and Color3.fromRGB(0, 175, 90) or Color3.fromRGB(50, 50, 60)
		callback(on)
		status.Text = text .. (on and " đã BẬT" or " đã TẮT")
	end)
end

createToggle("Kill Aura", 0.15, false, function(v) KillAura = v end)
createToggle("Hitbox", 0.29, true, function(v) HitboxOn = v end)
createToggle("Speed", 0.43, true, function(v) SpeedOn = v end)
createToggle("Inf Jump", 0.57, true, function(v) InfJump = v end)

-- Nút Test Attack
local testBtn = Instance.new("TextButton")
testBtn.Size = UDim2.new(0.86, 0, 0, 34)
testBtn.Position = UDim2.new(0.07, 0, 0.72, 0)
testBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
testBtn.Text = "Test Đánh 1 cái"
testBtn.TextColor3 = Color3.fromRGB(255,255,255)
testBtn.TextSize = 14
testBtn.Font = Enum.Font.GothamBold
testBtn.Parent = frame
Instance.new("UICorner", testBtn).CornerRadius = UDim.new(0, 8)

testBtn.MouseButton1Click:Connect(function()
	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
		task.wait(0.04)
		VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
	end)
	status.Text = "Đã test đánh"
end)

openBtn.MouseButton1Click:Connect(function()
	frame.Visible = not frame.Visible
end)
closeBtn.MouseButton1Click:Connect(function()
	frame.Visible = false
end)

-- ===== CHỨC NĂNG =====
local function addHitbox(char)
	if not char or hitboxes[char] then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local box = Instance.new("Part")
	box.Name = "SmashHitbox"
	box.Size = Vector3.new(HitboxSize, HitboxSize * 1.3, HitboxSize)
	box.Transparency = 0.68
	box.Color = Color3.fromRGB(255, 60, 40)
	box.Material = Enum.Material.ForceField
	box.CanCollide = false
	box.Massless = true
	box.Parent = char

	local weld = Instance.new("Weld")
	weld.Part0 = root
	weld.Part1 = box
	weld.C0 = CFrame.new(0, 0.4, 0)
	weld.Parent = box

	hitboxes[char] = box
end

-- Infinite Jump
UserInputService.JumpRequest:Connect(function()
	if InfJump and player.Character then
		local hum = player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
end)

-- Main
RunService.Heartbeat:Connect(function()
	local char = player.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return end

	-- SPEED
	if SpeedOn then
		hum.WalkSpeed = SpeedValue
	end

	-- HITBOX
	if HitboxOn then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr \~= player and plr.Character then
				addHitbox(plr.Character)
			end
		end
	end

	-- KILL AURA
	if KillAura and tick() - lastHit > Delay then
		local closest = nil
		local closestDist = Range

		for _, plr in ipairs(Players:GetPlayers()) do
			if plr \~= player and plr.Character then
				local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
				local tHum = plr.Character:FindFirstChildOfClass("Humanoid")
				if tRoot and tHum and tHum.Health > 0 then
					local dist = (root.Position - tRoot.Position).Magnitude
					if dist < closestDist then
						closestDist = dist
						closest = tRoot
					end
				end
			end
		end

		if closest then
			lastHit = tick()
			-- Quay mặt về địch
			root.CFrame = CFrame.lookAt(root.Position, Vector3.new(closest.Position.X, root.Position.Y, closest.Position.Z))
			-- Đánh
			pcall(function()
				VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
				task.wait(0.03)
				VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
			end)
			status.Text = "Đang đánh..."
		end
	end
end)

-- Giữ speed khi hồi sinh
player.CharacterAdded:Connect(function(char)
	task.wait(0.6)
	local hum = char:WaitForChild("Humanoid", 5)
	if hum and SpeedOn then
		hum.WalkSpeed = SpeedValue
	end
end)

print("SmashOK Loaded - Có chức năng")
]])()
