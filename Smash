loadstring([[
local success, err = pcall(function()
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	local VirtualInputManager = game:GetService("VirtualInputManager")
	local TweenService = game:GetService("TweenService")

	local player = Players.LocalPlayer
	local parentGui = (gethui and gethui()) or player:WaitForChild("PlayerGui")

	if parentGui:FindFirstChild("SmashX") then
		parentGui.SmashX:Destroy()
	end

	-- ===== Cài đặt =====
	local S = {
		KillAura = false,
		Hitbox = true,
		Speed = true,
		InfJump = true,
		Range = 23,
		HitboxSize = 42,
		SpeedValue = 33,
		Delay = 0.12,
	}

	local hitboxes = {}
	local lastHit = 0

	-- ===== GUI =====
	local gui = Instance.new("ScreenGui")
	gui.Name = "SmashX"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = parentGui

	-- Nút nổi
	local openBtn = Instance.new("TextButton")
	openBtn.Size = UDim2.new(0, 60, 0, 60)
	openBtn.Position = UDim2.new(1, -75, 0.28, 0)
	openBtn.BackgroundColor3 = Color3.fromRGB(255, 60, 40)
	openBtn.Text = "SMASH"
	openBtn.TextColor3 = Color3.fromRGB(255,255,255)
	openBtn.TextSize = 13
	openBtn.Font = Enum.Font.GothamBold
	openBtn.Parent = gui
	Instance.new("UICorner", openBtn).CornerRadius = UDim.new(1,0)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 120, 80)
	stroke.Thickness = 2
	stroke.Parent = openBtn

	-- Frame chính
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 270, 0, 310)
	frame.Position = UDim2.new(0.5, -135, 0.5, -155)
	frame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
	frame.Visible = false
	frame.Parent = gui
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 14)

	local frameStroke = Instance.new("UIStroke")
	frameStroke.Color = Color3.fromRGB(50, 50, 60)
	frameStroke.Thickness = 1.5
	frameStroke.Parent = frame

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 42)
	title.BackgroundTransparency = 1
	title.Text = "PROJECT SMASH"
	title.TextColor3 = Color3.fromRGB(255, 80, 50)
	title.TextSize = 18
	title.Font = Enum.Font.GothamBold
	title.Parent = frame

	local closeBtn = Instance.new("TextButton")
	closeBtn.Size = UDim2.new(0, 30, 0, 30)
	closeBtn.Position = UDim2.new(1, -36, 0, 6)
	closeBtn.BackgroundColor3 = Color3.fromRGB(190, 40, 40)
	closeBtn.Text = "X"
	closeBtn.TextColor3 = Color3.fromRGB(255,255,255)
	closeBtn.TextSize = 15
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.Parent = frame
	Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 8)

	local function createToggle(name, y, default, callback)
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0.86, 0, 0, 38)
		btn.Position = UDim2.new(0.07, 0, y, 0)
		btn.BackgroundColor3 = default and Color3.fromRGB(0, 170, 90) or Color3.fromRGB(45, 45, 55)
		btn.Text = name .. (default and "  •  ON" or "  •  OFF")
		btn.TextColor3 = Color3.fromRGB(255,255,255)
		btn.TextSize = 15
		btn.Font = Enum.Font.GothamBold
		btn.Parent = frame
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 9)

		local on = default
		btn.MouseButton1Click:Connect(function()
			on = not on
			btn.Text = name .. (on and "  •  ON" or "  •  OFF")
			btn.BackgroundColor3 = on and Color3.fromRGB(0, 170, 90) or Color3.fromRGB(45, 45, 55)
			callback(on)
		end)
	end

	createToggle("Kill Aura", 0.17, false, function(v) S.KillAura = v end)
	createToggle("Hitbox", 0.32, true, function(v) S.Hitbox = v end)
	createToggle("Speed", 0.47, true, function(v) S.Speed = v end)
	createToggle("Inf Jump", 0.62, true, function(v) S.InfJump = v end)

	local status = Instance.new("TextLabel")
	status.Size = UDim2.new(1, 0, 0, 22)
	status.Position = UDim2.new(0, 0, 0.80, 0)
	status.BackgroundTransparency = 1
	status.Text = "Sẵn sàng"
	status.TextColor3 = Color3.fromRGB(140, 140, 150)
	status.TextSize = 13
	status.Font = Enum.Font.Gotham
	status.Parent = frame

	-- ===== Chức năng =====
	local function addHitbox(char)
		if not char or hitboxes[char] then return end
		local root = char:FindFirstChild("HumanoidRootPart")
		if not root then return end

		local box = Instance.new("Part")
		box.Name = "SX_Hitbox"
		box.Size = Vector3.new(S.HitboxSize, S.HitboxSize * 1.25, S.HitboxSize)
		box.Transparency = 0.72
		box.Color = Color3.fromRGB(255, 70, 40)
		box.Material = Enum.Material.ForceField
		box.CanCollide = false
		box.Massless = true
		box.CastShadow = false
		box.Parent = char

		local weld = Instance.new("Weld")
		weld.Part0 = root
		weld.Part1 = box
		weld.C0 = CFrame.new(0, 0.4, 0)
		weld.Parent = box

		hitboxes[char] = box
	end

	local function clearHitboxes()
		for char, box in pairs(hitboxes) do
			pcall(function() box:Destroy() end)
			hitboxes[char] = nil
		end
	end

	local function getClosest()
		local closest, dist = nil, S.Range
		local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not myRoot then return nil end

		for _, plr in ipairs(Players:GetPlayers()) do
			if plr \~= player and plr.Character then
				local root = plr.Character:FindFirstChild("HumanoidRootPart")
				local hum = plr.Character:FindFirstChildOfClass("Humanoid")
				if root and hum and hum.Health > 0 then
					local d = (myRoot.Position - root.Position).Magnitude
					if d < dist then
						dist = d
						closest = plr
					end
				end
			end
		end
		return closest
	end

	local function attack()
		pcall(function()
			VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
			task.wait(0.025)
			VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
		end)
	end

	-- Infinite Jump
	UserInputService.JumpRequest:Connect(function()
		if S.InfJump and player.Character then
			local hum = player.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end
	end)

	-- Main Loop
	RunService.Heartbeat:Connect(function()
		local char = player.Character
		if not char then return end

		-- Speed (force liên tục)
		if S.Speed then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.WalkSpeed = S.SpeedValue
			end
		end

		-- Hitbox
		if S.Hitbox then
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr \~= player and plr.Character then
					addHitbox(plr.Character)
				end
			end
		else
			clearHitboxes()
		end

		-- Kill Aura
		if S.KillAura and tick() - lastHit > S.Delay then
			local target = getClosest()
			if target then
				lastHit = tick()
				local myRoot = char:FindFirstChild("HumanoidRootPart")
				local tRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
				if myRoot and tRoot then
					myRoot.CFrame = CFrame.lookAt(myRoot.Position, Vector3.new(tRoot.Position.X, myRoot.Position.Y, tRoot.Position.Z))
					attack()
					status.Text = "Đang đánh: " .. target.Name
				end
			end
		end
	end)

	-- Giữ speed khi respawn
	player.CharacterAdded:Connect(function(char)
		task.wait(0.6)
		if S.Speed then
			local hum = char:WaitForChild("Humanoid", 5)
			if hum then hum.WalkSpeed = S.SpeedValue end
		end
	end)

	Players.PlayerRemoving:Connect(function(plr)
		if plr.Character and hitboxes[plr.Character] then
			pcall(function() hitboxes[plr.Character]:Destroy() end)
			hitboxes[plr.Character] = nil
		end
	end)

	-- Nút
	openBtn.MouseButton1Click:Connect(function()
		frame.Visible = not frame.Visible
	end)

	closeBtn.MouseButton1Click:Connect(function()
		frame.Visible = false
	end)

	print("[SmashX] Loaded successfully")
end)

if not success then
	warn("[SmashX] Error:", err)
end
]])()
