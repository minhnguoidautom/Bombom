loadstring([[
local success, err = pcall(function()
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	local VirtualInputManager = game:GetService("VirtualInputManager")

	local player = Players.LocalPlayer
	local parentGui = (gethui and gethui()) or player:WaitForChild("PlayerGui")

	if parentGui:FindFirstChild("SmashAimGui") then
		parentGui.SmashAimGui:Destroy()
	end

	local Settings = {
		KillAura = false,
		Hitbox = true,
		Speed = true,
		InfJump = true,
		AuraRange = 26,
		HitboxSize = 48,
		WalkSpeed = 34,
		AttackDelay = 0.13,
		TargetMode = "Closest",
		SelectedTarget = nil,
	}

	local hitboxes = {}
	local lastAttack = 0

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "SmashAimGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = parentGui

	local openBtn = Instance.new("TextButton")
	openBtn.Size = UDim2.new(0, 58, 0, 58)
	openBtn.Position = UDim2.new(1, -72, 0.28, 0)
	openBtn.BackgroundColor3 = Color3.fromRGB(255, 70, 40)
	openBtn.Text = "SMASH"
	openBtn.TextColor3 = Color3.fromRGB(255,255,255)
	openBtn.TextSize = 13
	openBtn.Font = Enum.Font.GothamBold
	openBtn.Parent = screenGui
	Instance.new("UICorner", openBtn).CornerRadius = UDim.new(1,0)

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 290, 0, 420)
	frame.Position = UDim2.new(0.5, -145, 0.5, -210)
	frame.BackgroundColor3 = Color3.fromRGB(16, 16, 22)
	frame.Visible = false
	frame.Parent = screenGui
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 14)

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1,0,0,40)
	title.BackgroundTransparency = 1
	title.Text = "Project Smash Aim"
	title.TextColor3 = Color3.fromRGB(255, 90, 50)
	title.TextSize = 18
	title.Font = Enum.Font.GothamBold
	title.Parent = frame

	local closeBtn = Instance.new("TextButton")
	closeBtn.Size = UDim2.new(0, 30, 0, 30)
	closeBtn.Position = UDim2.new(1, -36, 0, 5)
	closeBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
	closeBtn.Text = "X"
	closeBtn.TextColor3 = Color3.fromRGB(255,255,255)
	closeBtn.TextSize = 15
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.Parent = frame
	Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 7)

	local function createToggle(name, yPos, default, callback)
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0.86, 0, 0, 34)
		btn.Position = UDim2.new(0.07, 0, yPos, 0)
		btn.BackgroundColor3 = default and Color3.fromRGB(0, 170, 90) or Color3.fromRGB(60, 60, 70)
		btn.Text = name .. (default and ": ON" or ": OFF")
		btn.TextColor3 = Color3.fromRGB(255,255,255)
		btn.TextSize = 14
		btn.Font = Enum.Font.GothamBold
		btn.Parent = frame
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

		local state = default
		btn.MouseButton1Click:Connect(function()
			state = not state
			btn.Text = name .. (state and ": ON" or ": OFF")
			btn.BackgroundColor3 = state and Color3.fromRGB(0, 170, 90) or Color3.fromRGB(60, 60, 70)
			callback(state)
		end)
	end

	createToggle("Kill Aura", 0.12, false, function(v) Settings.KillAura = v end)
	createToggle("Hitbox", 0.22, true, function(v) Settings.Hitbox = v end)
	createToggle("Speed", 0.32, true, function(v) Settings.Speed = v end)
	createToggle("Inf Jump", 0.42, true, function(v) Settings.InfJump = v end)

	local targetLabel = Instance.new("TextLabel")
	targetLabel.Size = UDim2.new(1, 0, 0, 22)
	targetLabel.Position = UDim2.new(0, 0, 0.53, 0)
	targetLabel.BackgroundTransparency = 1
	targetLabel.Text = "Mục tiêu: Gần nhất"
	targetLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	targetLabel.TextSize = 13
	targetLabel.Font = Enum.Font.Gotham
	targetLabel.Parent = frame

	local closestBtn = Instance.new("TextButton")
	closestBtn.Size = UDim2.new(0.86, 0, 0, 32)
	closestBtn.Position = UDim2.new(0.07, 0, 0.60, 0)
	closestBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 220)
	closestBtn.Text = "Aim: Người gần nhất"
	closestBtn.TextColor3 = Color3.fromRGB(255,255,255)
	closestBtn.TextSize = 13
	closestBtn.Font = Enum.Font.GothamBold
	closestBtn.Parent = frame
	Instance.new("UICorner", closestBtn).CornerRadius = UDim.new(0, 7)

	local playerList = Instance.new("ScrollingFrame")
	playerList.Size = UDim2.new(0.86, 0, 0, 90)
	playerList.Position = UDim2.new(0.07, 0, 0.70, 0)
	playerList.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
	playerList.BorderSizePixel = 0
	playerList.ScrollBarThickness = 4
	playerList.CanvasSize = UDim2.new(0, 0, 0, 0)
	playerList.Parent = frame
	Instance.new("UICorner", playerList).CornerRadius = UDim.new(0, 8)

	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 4)
	listLayout.Parent = playerList

	local function refreshPlayerList()
		for _, child in ipairs(playerList:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end

		local ySize = 0
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr \~= player then
				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(1, -8, 0, 28)
				btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
				btn.Text = plr.Name
				btn.TextColor3 = Color3.fromRGB(230, 230, 230)
				btn.TextSize = 13
				btn.Font = Enum.Font.Gotham
				btn.Parent = playerList
				Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

				btn.MouseButton1Click:Connect(function()
					Settings.TargetMode = "Selected"
					Settings.SelectedTarget = plr
					targetLabel.Text = "Mục tiêu: " .. plr.Name
					closestBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
				end)
				ySize = ySize + 32
			end
		end
		playerList.CanvasSize = UDim2.new(0, 0, 0, ySize)
	end

	closestBtn.MouseButton1Click:Connect(function()
		Settings.TargetMode = "Closest"
		Settings.SelectedTarget = nil
		targetLabel.Text = "Mục tiêu: Gần nhất"
		closestBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 220)
	end)

	local refreshBtn = Instance.new("TextButton")
	refreshBtn.Size = UDim2.new(0.86, 0, 0, 28)
	refreshBtn.Position = UDim2.new(0.07, 0, 0.93, 0)
	refreshBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
	refreshBtn.Text = "Làm mới danh sách"
	refreshBtn.TextColor3 = Color3.fromRGB(255,255,255)
	refreshBtn.TextSize = 12
	refreshBtn.Font = Enum.Font.Gotham
	refreshBtn.Parent = frame
	Instance.new("UICorner", refreshBtn).CornerRadius = UDim.new(0, 6)
	refreshBtn.MouseButton1Click:Connect(refreshPlayerList)

	local function createHitbox(char)
		if not char or hitboxes[char] then return end
		local root = char:FindFirstChild("HumanoidRootPart")
		if not root then return end

		local box = Instance.new("Part")
		box.Name = "SmashHitbox"
		box.Size = Vector3.new(Settings.HitboxSize, Settings.HitboxSize * 1.3, Settings.HitboxSize)
		box.Transparency = 0.7
		box.Color = Color3.fromRGB(255, 70, 40)
		box.Material = Enum.Material.ForceField
		box.CanCollide = false
		box.Massless = true
		box.Parent = char

		local weld = Instance.new("Weld")
		weld.Part0 = root
		weld.Part1 = box
		weld.C0 = CFrame.new(0, 0.5, 0)
		weld.Parent = box
		hitboxes[char] = box
	end

	local function clearHitboxes()
		for char, box in pairs(hitboxes) do
			pcall(function() box:Destroy() end)
			hitboxes[char] = nil
		end
	end

	local function getTarget()
		if Settings.TargetMode == "Selected" and Settings.SelectedTarget then
			local t = Settings.SelectedTarget
			if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
				local hum = t.Character:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then return t end
			end
			Settings.TargetMode = "Closest"
			Settings.SelectedTarget = nil
			targetLabel.Text = "Mục tiêu: Gần nhất"
		end

		local closest, dist = nil, Settings.AuraRange
		local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not myRoot then return nil end

		for _, plr in ipairs(Players:GetPlayers()) do
			if plr \~= player and plr.Character then
				local root = plr.Character:FindFirstChild("HumanoidRootPart")
				local hum = plr.Character:FindFirstChildOfClass("Humanoid")
				if root and hum and hum.Health > 0 then
					local d = (myRoot.Position - root.Position).Magnitude
					if d < dist then
						dist = d
						closest = plr
					end
				end
			end
		end
		return closest
	end

	local function doAttack()
		pcall(function()
			VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
			task.wait(0.02)
			VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
		end)
	end

	UserInputService.JumpRequest:Connect(function()
		if Settings.InfJump and player.Character then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end
	end)

	RunService.Heartbeat:Connect(function()
		if Settings.Speed and player.Character then
			local hum = player.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.WalkSpeed \~= Settings.WalkSpeed then
				hum.WalkSpeed = Settings.WalkSpeed
			end
		end

		if Settings.Hitbox then
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr \~= player and plr.Character then
					createHitbox(plr.Character)
				end
			end
		else
			clearHitboxes()
		end

		if Settings.KillAura then
			local target = getTarget()
			if target and tick() - lastAttack > Settings.AttackDelay then
				lastAttack = tick()
				local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				local tRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
				if myRoot and tRoot then
					myRoot.CFrame = CFrame.lookAt(myRoot.Position, Vector3.new(tRoot.Position.X, myRoot.Position.Y, tRoot.Position.Z))
					doAttack()
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(plr)
		if plr.Character and hitboxes[plr.Character] then
			pcall(function() hitboxes[plr.Character]:Destroy() end)
			hitboxes[plr.Character] = nil
		end
		if Settings.SelectedTarget == plr then
			Settings.TargetMode = "Closest"
			Settings.SelectedTarget = nil
			targetLabel.Text = "Mục tiêu: Gần nhất"
		end
	end)

	player.CharacterAdded:Connect(function(char)
		task.wait(0.5)
		if Settings.Speed then
			local hum = char:WaitForChild("Humanoid", 5)
			if hum then hum.WalkSpeed = Settings.WalkSpeed end
		end
	end)

	openBtn.MouseButton1Click:Connect(function()
		frame.Visible = not frame.Visible
		if frame.Visible then refreshPlayerList() end
	end)

	closeBtn.MouseButton1Click:Connect(function()
		frame.Visible = false
	end)

	Players.PlayerAdded:Connect(function()
		task.wait(1)
		if frame.Visible then refreshPlayerList() end
	end)
end)

if not success then
	warn("Smash Aim Error:", err)
end
]])()
