loadstring([[
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local VIM = game:GetService("VirtualInputManager")

local lp = Players.LocalPlayer
local pg = lp:WaitForChild("PlayerGui")

pcall(function()
	if pg:FindFirstChild("PS") then pg.PS:Destroy() end
end)

-- Settings
local KA = false
local HB = true
local SP = true
local IJ = true
local range = 25
local hbSize = 46
local spd = 38
local delay = 0.11
local last = 0
local boxes = {}

-- GUI
local g = Instance.new("ScreenGui")
g.Name = "PS"
g.ResetOnSpawn = false
g.IgnoreGuiInset = true
g.Parent = pg

local open = Instance.new("TextButton")
open.Size = UDim2.new(0,65,0,65)
open.Position = UDim2.new(1,-80,0.27,0)
open.BackgroundColor3 = Color3.fromRGB(255,50,30)
open.Text = "SMASH"
open.TextColor3 = Color3.new(1,1,1)
open.TextSize = 14
open.Font = Enum.Font.GothamBold
open.Parent = g
Instance.new("UICorner",open).CornerRadius = UDim.new(1,0)

local f = Instance.new("Frame")
f.Size = UDim2.new(0,260,0,340)
f.Position = UDim2.new(0.5,-130,0.5,-170)
f.BackgroundColor3 = Color3.fromRGB(14,14,20)
f.Visible = false
f.Parent = g
Instance.new("UICorner",f).CornerRadius = UDim.new(0,14)

local t = Instance.new("TextLabel")
t.Size = UDim2.new(1,0,0,40)
t.BackgroundTransparency = 1
t.Text = "PROJECT SMASH"
t.TextColor3 = Color3.fromRGB(255,70,40)
t.TextSize = 18
t.Font = Enum.Font.GothamBold
t.Parent = f

local x = Instance.new("TextButton")
x.Size = UDim2.new(0,30,0,30)
x.Position = UDim2.new(1,-36,0,5)
x.BackgroundColor3 = Color3.fromRGB(200,35,35)
x.Text = "X"
x.TextColor3 = Color3.new(1,1,1)
x.TextSize = 15
x.Font = Enum.Font.GothamBold
x.Parent = f
Instance.new("UICorner",x).CornerRadius = UDim.new(0,7)

local st = Instance.new("TextLabel")
st.Size = UDim2.new(1,0,0,22)
st.Position = UDim2.new(0,0,0.91,0)
st.BackgroundTransparency = 1
st.Text = "Sẵn sàng"
st.TextColor3 = Color3.fromRGB(160,160,170)
st.TextSize = 13
st.Font = Enum.Font.Gotham
st.Parent = f

local function btn(name, y, def, cb)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0.86,0,0,40)
	b.Position = UDim2.new(0.07,0,y,0)
	b.BackgroundColor3 = def and Color3.fromRGB(0,175,90) or Color3.fromRGB(45,45,55)
	b.Text = name..(def and "  • ON" or "  • OFF")
	b.TextColor3 = Color3.new(1,1,1)
	b.TextSize = 15
	b.Font = Enum.Font.GothamBold
	b.Parent = f
	Instance.new("UICorner",b).CornerRadius = UDim.new(0,9)
	local on = def
	b.MouseButton1Click:Connect(function()
		on = not on
		b.Text = name..(on and "  • ON" or "  • OFF")
		b.BackgroundColor3 = on and Color3.fromRGB(0,175,90) or Color3.fromRGB(45,45,55)
		cb(on)
		st.Text = name..(on and " BẬT" or " TẮT")
	end)
end

btn("Kill Aura", 0.14, false, function(v) KA = v end)
btn("Hitbox", 0.28, true, function(v) HB = v end)
btn("Speed", 0.42, true, function(v) SP = v end)
btn("Inf Jump", 0.56, true, function(v) IJ = v end)

local test = Instance.new("TextButton")
test.Size = UDim2.new(0.86,0,0,36)
test.Position = UDim2.new(0.07,0,0.71,0)
test.BackgroundColor3 = Color3.fromRGB(0,130,210)
test.Text = "TEST ĐÁNH"
test.TextColor3 = Color3.new(1,1,1)
test.TextSize = 14
test.Font = Enum.Font.GothamBold
test.Parent = f
Instance.new("UICorner",test).CornerRadius = UDim.new(0,8)

test.MouseButton1Click:Connect(function()
	pcall(function()
		VIM:SendMouseButtonEvent(0,0,0,true,game,0)
		task.wait(0.05)
		VIM:SendMouseButtonEvent(0,0,0,false,game,0)
	end)
	st.Text = "Đã test đánh"
end)

open.MouseButton1Click:Connect(function() f.Visible = not f.Visible end)
x.MouseButton1Click:Connect(function() f.Visible = false end)

-- Hitbox
local function addBox(c)
	if not c or boxes[c] then return end
	local r = c:FindFirstChild("HumanoidRootPart")
	if not r then return end
	local p = Instance.new("Part")
	p.Name = "HB"
	p.Size = Vector3.new(hbSize, hbSize*1.3, hbSize)
	p.Transparency = 0.65
	p.Color = Color3.fromRGB(255,60,30)
	p.Material = Enum.Material.ForceField
	p.CanCollide = false
	p.Massless = true
	p.Parent = c
	local w = Instance.new("Weld")
	w.Part0 = r
	w.Part1 = p
	w.Parent = p
	boxes[c] = p
end

-- Inf Jump
UIS.JumpRequest:Connect(function()
	if IJ and lp.Character then
		local h = lp.Character:FindFirstChildOfClass("Humanoid")
		if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
	end
end)

-- Main Loop
RunService.Heartbeat:Connect(function()
	local c = lp.Character
	if not c then return end
	local h = c:FindFirstChildOfClass("Humanoid")
	local r = c:FindFirstChild("HumanoidRootPart")
	if not h or not r then return end

	-- SPEED (force mỗi frame)
	if SP then
		h.WalkSpeed = spd
	end

	-- HITBOX
	if HB then
		for _,p in ipairs(Players:GetPlayers()) do
			if p \~= lp and p.Character then
				addBox(p.Character)
			end
		end
	end

	-- KILL AURA
	if KA and tick()-last > delay then
		local closest, dist = nil, range
		for _,p in ipairs(Players:GetPlayers()) do
			if p \~= lp and p.Character then
				local tr = p.Character:FindFirstChild("HumanoidRootPart")
				local th = p.Character:FindFirstChildOfClass("Humanoid")
				if tr and th and th.Health > 0 then
					local d = (r.Position - tr.Position).Magnitude
					if d < dist then
						dist = d
						closest = tr
					end
				end
			end
		end
		if closest then
			last = tick()
			r.CFrame = CFrame.lookAt(r.Position, Vector3.new(closest.Position.X, r.Position.Y, closest.Position.Z))
			pcall(function()
				VIM:SendMouseButtonEvent(0,0,0,true,game,0)
				task.wait(0.03)
				VIM:SendMouseButtonEvent(0,0,0,false,game,0)
			end)
			st.Text = "Đang đánh"
		end
	end
end)

-- Respawn giữ speed
lp.CharacterAdded:Connect(function(c)
	task.wait(0.5)
	local h = c:WaitForChild("Humanoid",5)
	if h and SP then h.WalkSpeed = spd end
end)

print("PS Loaded")
]])()
