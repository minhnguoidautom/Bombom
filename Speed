loadstring([[
local success, err = pcall(function()
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	local VirtualInputManager = game:GetService("VirtualInputManager")

	local player = Players.LocalPlayer
	local parentGui = (gethui and gethui()) or player:WaitForChild("PlayerGui")

	if parentGui:FindFirstChild("SpeedMenuGui") then
		parentGui.SpeedMenuGui:Destroy()
	end

	local currentSpeed = 16
	local currentJump = 50
	local reachEnabled = false
	local reachValue = 20
	local fastAttack = false
	local lastAttack = 0

	-- ========== GUI (tối ưu điện thoại) ==========
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "SpeedMenuGui"
	screenGui.ResetOnSpawn = false
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = parentGui

	-- Nút nổi to hơn cho điện thoại
	local openButton = Instance.new("TextButton")
	openButton.Size = UDim2.new(0, 65, 0, 65)
	openButton.Position = UDim2.new(1, -80, 0.45, 0)
	openButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
	openButton.Text = "MENU"
	openButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	openButton.TextSize = 15
	openButton.Font = Enum.Font.GothamBold
	openButton.Parent = screenGui
	Instance.new("UICorner", openButton).CornerRadius = UDim.new(1, 0)

	-- Frame chính
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 320, 0, 400)
	frame.Position = UDim2.new(0.5, -160, 0.5, -200)
	frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
	frame.BorderSizePixel = 0
	frame.Visible = false
	frame.Parent = screenGui
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 14)

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 40)
	title.BackgroundTransparency = 1
	title.Text = "Choose An Ability"
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.TextSize = 20
	title.Font = Enum.Font.GothamBold
	title.Parent = frame

	-- Speed
	local textBox = Instance.new("TextBox")
	textBox.Size = UDim2.new(0.85, 0, 0, 42)
	textBox.Position = UDim2.new(0.075, 0, 0.13, 0)
	textBox.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
	textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	textBox.PlaceholderText = "Nhập số Speed..."
	textBox.TextSize = 17
	textBox.Font = Enum.Font.Gotham
	textBox.Parent = frame
	Instance.new("UICorner", textBox).CornerRadius = UDim.new(0, 10)

	local setButton = Instance.new("TextButton")
	setButton.Size = UDim2.new(0.85, 0, 0, 42)
	setButton.Position = UDim2.new(0.075, 0, 0.26, 0)
	setButton.BackgroundColor3 = Color3.fromRGB(0, 160, 255)
	setButton.Text = "Set Speed"
	setButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	setButton.TextSize = 17
	setButton.Font = Enum.Font.GothamBold
	setButton.Parent = frame
	Instance.new("UICorner", setButton).CornerRadius = UDim.new(0, 10)

	-- Reach
	local reachBox = Instance.new("TextBox")
	reachBox.Size = UDim2.new(0.85, 0, 0, 42)
	reachBox.Position = UDim2.new(0.075, 0, 0.40, 0)
	reachBox.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
	reachBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	reachBox.PlaceholderText = "Nhập số Đánh xa (10-50)"
	reachBox.TextSize = 16
	reachBox.Font = Enum.Font.Gotham
	reachBox.Parent = frame
	Instance.new("UICorner", reachBox).CornerRadius = UDim.new(0, 10)

	local reachButton = Instance.new("TextButton")
	reachButton.Size = UDim2.new(0.85, 0, 0, 42)
	reachButton.Position = UDim2.new(0.075, 0, 0.53, 0)
	reachButton.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
	reachButton.Text = "Đánh xa: OFF"
	reachButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	reachButton.TextSize = 16
	reachButton.Font = Enum.Font.GothamBold
	reachButton.Parent = frame
	Instance.new("UICorner", reachButton).CornerRadius = UDim.new(0, 10)

	-- Fast Attack
	local fastButton = Instance.new("TextButton")
	fastButton.Size = UDim2.new(0.85, 0, 0, 42)
	fastButton.Position = UDim2.new(0.075, 0, 0.66, 0)
	fastButton.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
	fastButton.Text = "Đánh nhanh + Hồi chiêu: OFF"
	fastButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	fastButton.TextSize = 15
	fastButton.Font = Enum.Font.GothamBold
	fastButton.Parent = frame
	Instance.new("UICorner", fastButton).CornerRadius = UDim.new(0, 10)

	local statusLabel = Instance.new("TextLabel")
	statusLabel.Size = UDim2.new(1, 0, 0, 25)
	statusLabel.Position = UDim2.new(0, 0, 0.80, 0)
	statusLabel.BackgroundTransparency = 1
	statusLabel.Text = "Speed: 16 | Reach: 20"
	statusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
	statusLabel.TextSize = 14
	statusLabel.Font = Enum.Font.Gotham
	statusLabel.Parent = frame

	local closeButton = Instance.new("TextButton")
	closeButton.Size = UDim2.new(0, 36, 0, 36)
	closeButton.Position = UDim2.new(1, -42, 0, 6)
	closeButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
	closeButton.Text = "X"
	closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	closeButton.TextSize = 18
	closeButton.Font = Enum.Font.GothamBold
	closeButton.Parent = frame
	Instance.new("UICorner", closeButton).CornerRadius = UDim.new(0, 8)

	-- ========== Chức năng ==========
	local function toggleMenu()
		frame.Visible = not frame.Visible
	end

	openButton.MouseButton1Click:Connect(toggleMenu)

	setButton.MouseButton1Click:Connect(function()
		local speed = tonumber(textBox.Text)
		if speed then
			currentSpeed = math.clamp(speed, 0, 500)
			statusLabel.Text = "Speed: " .. currentSpeed .. " | Reach: " .. reachValue
			setButton.Text = "Đã set!"
			task.wait(0.7)
			setButton.Text = "Set Speed"
			textBox.Text = ""
		end
	end)

	reachButton.MouseButton1Click:Connect(function()
		local val = tonumber(reachBox.Text)
		if val then
			reachValue = math.clamp(val, 8, 60)
			reachBox.Text = ""
		end
		reachEnabled = not reachEnabled
		reachButton.Text = reachEnabled and ("Đánh xa: ON (" .. reachValue .. ")") or "Đánh xa: OFF"
		reachButton.BackgroundColor3 = reachEnabled and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(50, 50, 55)
		statusLabel.Text = "Speed: " .. currentSpeed .. " | Reach: " .. reachValue
	end)

	fastButton.MouseButton1Click:Connect(function()
		fastAttack = not fastAttack
		fastButton.Text = fastAttack and "Đánh nhanh + Hồi chiêu: ON" or "Đánh nhanh + Hồi chiêu: OFF"
		fastButton.BackgroundColor3 = fastAttack and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(50, 50, 55)
	end)

	closeButton.MouseButton1Click:Connect(function()
		frame.Visible = false
	end)

	-- Spam đánh
	local function spamAttack()
		pcall(function()
			VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
			VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)

			local keys = {
				Enum.KeyCode.Q, Enum.KeyCode.E, Enum.KeyCode.R, 
				Enum.KeyCode.F, Enum.KeyCode.One, Enum.KeyCode.Two
			}
			for _, key in ipairs(keys) do
				VirtualInputManager:SendKeyEvent(true, key, false, game)
				VirtualInputManager:SendKeyEvent(false, key, false, game)
			end
		end)
	end

	-- Phóng to hitbox
	local function expandHitboxes()
		local character = player.Character
		if not character then return end
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				local name = string.lower(part.Name)
				if name:find("hit") or name:find("attack") or name:find("damage") 
				or name:find("slash") or name:find("punch") or name:find("box") then
					part.Size = Vector3.new(reachValue, reachValue, reachValue)
					part.Transparency = 0.6
					part.CanCollide = false
				end
			end
		end
	end

	-- ========== Logic ==========
	RunService.Heartbeat:Connect(function()
		local character = player.Character
		if not character then return end

		local humanoid = character:FindFirstChildOfClass("Humanoid")

		if humanoid then
			humanoid.WalkSpeed = currentSpeed
			humanoid.JumpPower = currentJump
			humanoid.JumpHeight = 7.2
		end

		if reachEnabled then
			expandHitboxes()
		end

		if fastAttack and tick() - lastAttack >= 0.11 then
			lastAttack = tick()
			spamAttack()

			local tool = character:FindFirstChildOfClass("Tool")
			if tool then
				pcall(function() tool:Activate() end)
			end
		end
	end)

	player.CharacterAdded:Connect(function(char)
		task.wait(0.6)
		local hum = char:WaitForChild("Humanoid", 5)
		if hum then
			hum.WalkSpeed = currentSpeed
			hum.JumpPower = currentJump
		end
	end)
end)

if not success then
	warn("Lỗi:", err)
end
]])()
