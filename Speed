loadstring([[
local success, err = pcall(function()
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	local Workspace = game:GetService("Workspace")
	local VirtualInputManager = game:GetService("VirtualInputManager")

	local player = Players.LocalPlayer
	local parentGui = (gethui and gethui()) or player:WaitForChild("PlayerGui")

	if parentGui:FindFirstChild("SpeedMenuGui") then
		parentGui.SpeedMenuGui:Destroy()
	end

	-- Biến điều khiển
	local currentSpeed = 16
	local speedEnabled = true
	local instantInteract = false
	local reachEnabled = false
	local reachValue = 15
	local fastAttack = false
	local noCooldown = false
	local lastAttack = 0

	-- ========== GUI ==========
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "SpeedMenuGui"
	screenGui.ResetOnSpawn = false
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = parentGui

	-- Nút nổi
	local openButton = Instance.new("TextButton")
	openButton.Name = "OpenButton"
	openButton.Size = UDim2.new(0, 55, 0, 55)
	openButton.Position = UDim2.new(1, -70, 0.4, 0)
	openButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
	openButton.Text = "SPD"
	openButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	openButton.TextSize = 16
	openButton.Font = Enum.Font.GothamBold
	openButton.Parent = screenGui

	local openCorner = Instance.new("UICorner")
	openCorner.CornerRadius = UDim.new(1, 0)
	openCorner.Parent = openButton

	-- Frame chính (cao hơn để chứa nhiều nút)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 300, 0, 420)
	frame.Position = UDim2.new(0.5, -150, 0.5, -210)
	frame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
	frame.BorderSizePixel = 0
	frame.Visible = false
	frame.Parent = screenGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = frame

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 36)
	title.BackgroundTransparency = 1
	title.Text = "Speed + Combat Menu"
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.TextSize = 18
	title.Font = Enum.Font.GothamBold
	title.Parent = frame

	-- Speed
	local textBox = Instance.new("TextBox")
	textBox.Size = UDim2.new(0.8, 0, 0, 34)
	textBox.Position = UDim2.new(0.1, 0, 0.10, 0)
	textBox.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
	textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	textBox.PlaceholderText = "Nhập số speed..."
	textBox.TextSize = 15
	textBox.Font = Enum.Font.Gotham
	textBox.Parent = frame
	Instance.new("UICorner", textBox).CornerRadius = UDim.new(0, 8)

	local setButton = Instance.new("TextButton")
	setButton.Size = UDim2.new(0.8, 0, 0, 34)
	setButton.Position = UDim2.new(0.1, 0, 0.20, 0)
	setButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
	setButton.Text = "Set Speed"
	setButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	setButton.TextSize = 15
	setButton.Font = Enum.Font.GothamBold
	setButton.Parent = frame
	Instance.new("UICorner", setButton).CornerRadius = UDim.new(0, 8)

	-- Reach
	local reachBox = Instance.new("TextBox")
	reachBox.Size = UDim2.new(0.8, 0, 0, 34)
	reachBox.Position = UDim2.new(0.1, 0, 0.31, 0)
	reachBox.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
	reachBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	reachBox.PlaceholderText = "Nhập số đánh xa (vd: 20)"
	reachBox.TextSize = 15
	reachBox.Font = Enum.Font.Gotham
	reachBox.Parent = frame
	Instance.new("UICorner", reachBox).CornerRadius = UDim.new(0, 8)

	local reachButton = Instance.new("TextButton")
	reachButton.Size = UDim2.new(0.8, 0, 0, 34)
	reachButton.Position = UDim2.new(0.1, 0, 0.41, 0)
	reachButton.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
	reachButton.Text = "Đánh xa: OFF"
	reachButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	reachButton.TextSize = 15
	reachButton.Font = Enum.Font.GothamBold
	reachButton.Parent = frame
	Instance.new("UICorner", reachButton).CornerRadius = UDim.new(0, 8)

	-- Fast Attack
	local fastButton = Instance.new("TextButton")
	fastButton.Size = UDim2.new(0.8, 0, 0, 34)
	fastButton.Position = UDim2.new(0.1, 0, 0.52, 0)
	fastButton.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
	fastButton.Text = "Đánh nhanh (0.1s): OFF"
	fastButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	fastButton.TextSize = 14
	fastButton.Font = Enum.Font.GothamBold
	fastButton.Parent = frame
	Instance.new("UICorner", fastButton).CornerRadius = UDim.new(0, 8)

	-- No Cooldown
	local cdButton = Instance.new("TextButton")
	cdButton.Size = UDim2.new(0.8, 0, 0, 34)
	cdButton.Position = UDim2.new(0.1, 0, 0.63, 0)
	cdButton.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
	cdButton.Text = "Hồi chiêu nhanh: OFF"
	cdButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	cdButton.TextSize = 14
	cdButton.Font = Enum.Font.GothamBold
	cdButton.Parent = frame
	Instance.new("UICorner", cdButton).CornerRadius = UDim.new(0, 8)

	-- Instant Interact
	local interactButton = Instance.new("TextButton")
	interactButton.Size = UDim2.new(0.8, 0, 0, 34)
	interactButton.Position = UDim2.new(0.1, 0, 0.74, 0)
	interactButton.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
	interactButton.Text = "Instant Interact: OFF"
	interactButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	interactButton.TextSize = 14
	interactButton.Font = Enum.Font.GothamBold
	interactButton.Parent = frame
	Instance.new("UICorner", interactButton).CornerRadius = UDim.new(0, 8)

	local statusLabel = Instance.new("TextLabel")
	statusLabel.Size = UDim2.new(1, 0, 0, 22)
	statusLabel.Position = UDim2.new(0, 0, 0.85, 0)
	statusLabel.BackgroundTransparency = 1
	statusLabel.Text = "Speed: 16 | Reach: 15"
	statusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
	statusLabel.TextSize = 13
	statusLabel.Font = Enum.Font.Gotham
	statusLabel.Parent = frame

	local closeButton = Instance.new("TextButton")
	closeButton.Size = UDim2.new(0, 30, 0, 30)
	closeButton.Position = UDim2.new(1, -36, 0, 4)
	closeButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
	closeButton.Text = "X"
	closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	closeButton.TextSize = 15
	closeButton.Font = Enum.Font.GothamBold
	closeButton.Parent = frame
	Instance.new("UICorner", closeButton).CornerRadius = UDim.new(0, 6)

	-- ========== Chức năng ==========
	local function toggleMenu()
		frame.Visible = not frame.Visible
	end

	openButton.MouseButton1Click:Connect(toggleMenu)
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then return end
		if input.KeyCode == Enum.KeyCode.P then toggleMenu() end
	end)

	setButton.MouseButton1Click:Connect(function()
		local speed = tonumber(textBox.Text)
		if speed then
			currentSpeed = math.clamp(speed, 0, 500)
			statusLabel.Text = "Speed: " .. currentSpeed .. " | Reach: " .. reachValue
			setButton.Text = "Đã set!"
			task.wait(0.6)
			setButton.Text = "Set Speed"
			textBox.Text = ""
		end
	end)

	reachButton.MouseButton1Click:Connect(function()
		local val = tonumber(reachBox.Text)
		if val then
			reachValue = math.clamp(val, 5, 100)
			reachBox.Text = ""
		end
		reachEnabled = not reachEnabled
		reachButton.Text = reachEnabled and "Đánh xa: ON (" .. reachValue .. ")" or "Đánh xa: OFF"
		reachButton.BackgroundColor3 = reachEnabled and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(50, 50, 55)
		statusLabel.Text = "Speed: " .. currentSpeed .. " | Reach: " .. reachValue
	end)

	fastButton.MouseButton1Click:Connect(function()
		fastAttack = not fastAttack
		fastButton.Text = fastAttack and "Đánh nhanh (0.1s): ON" or "Đánh nhanh (0.1s): OFF"
		fastButton.BackgroundColor3 = fastAttack and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(50, 50, 55)
	end)

	cdButton.MouseButton1Click:Connect(function()
		noCooldown = not noCooldown
		cdButton.Text = noCooldown and "Hồi chiêu nhanh: ON" or "Hồi chiêu nhanh: OFF"
		cdButton.BackgroundColor3 = noCooldown and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(50, 50, 55)
	end)

	interactButton.MouseButton1Click:Connect(function()
		instantInteract = not instantInteract
		interactButton.Text = instantInteract and "Instant Interact: ON" or "Instant Interact: OFF"
		interactButton.BackgroundColor3 = instantInteract and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(50, 50, 55)
	end)

	closeButton.MouseButton1Click:Connect(function()
		frame.Visible = false
	end)

	-- ========== Logic chính ==========
	RunService.Heartbeat:Connect(function()
		local character = player.Character
		if not character then return end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local root = character:FindFirstChild("HumanoidRootPart")

		-- Force Speed
		if speedEnabled and humanoid then
			humanoid.WalkSpeed = currentSpeed
		end

		-- Instant Interact
		if instantInteract then
			for _, obj in ipairs(Workspace:GetDescendants()) do
				if obj:IsA("ProximityPrompt") then
					obj.HoldDuration = 0
				end
			end
		end

		-- No Cooldown (xóa cooldown của tool / ability)
		if noCooldown then
			local function clearCD(container)
				for _, v in ipairs(container:GetDescendants()) do
					if v:IsA("NumberValue") or v:IsA("IntValue") then
						local name = string.lower(v.Name)
						if name:find("cooldown") or name:find("cd") or name:find("delay") or name:find("wait") then
							v.Value = 0
						end
					elseif v:IsA("BoolValue") and (string.lower(v.Name):find("cooldown") or string.lower(v.Name):find("debounce")) then
						v.Value = false
					end
				end
			end
			if player:FindFirstChild("Backpack") then clearCD(player.Backpack) end
			if character then clearCD(character) end
		end

		-- Fast Attack + Reach (đánh liên tục 0.1s trong phạm vi)
		if (fastAttack or reachEnabled) and root and tick() - lastAttack >= 0.1 then
			lastAttack = tick()
			for _, other in ipairs(Players:GetPlayers()) do
				if other ~= player and other.Character then
					local otherRoot = other.Character:FindFirstChild("HumanoidRootPart")
					local otherHum = other.Character:FindFirstChildOfClass("Humanoid")
					if otherRoot and otherHum and otherHum.Health > 0 then
						local dist = (root.Position - otherRoot.Position).Magnitude
						if dist <= reachValue then
							-- Thử spam click / attack
							pcall(function()
								VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
								VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
							end)
							-- Thử kích hoạt tool
							local tool = character:FindFirstChildOfClass("Tool")
							if tool then
								pcall(function() tool:Activate() end)
							end
						end
					end
				end
			end
		end
	end)

	player.CharacterAdded:Connect(function(char)
		task.wait(0.5)
		local hum = char:WaitForChild("Humanoid", 5)
		if hum then hum.WalkSpeed = currentSpeed end
	end)
end)

if not success then
	warn("Lỗi:", err)
end
]])()
