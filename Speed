local success, err = pcall(function()
    local Players = game:GetService("Players")
    local UserInputService = game:GetService("UserInputService")

    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")

    -- Ưu tiên dùng gethui() (tốt cho Delta)
    local parentGui = gethui and gethui() or playerGui

    -- Xóa menu cũ nếu có
    if parentGui:FindFirstChild("SpeedMenuGui") then
        parentGui.SpeedMenuGui:Destroy()
    end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "SpeedMenuGui"
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.Parent = parentGui

    local frame = Instance.new("Frame")
    frame.Name = "MainFrame"
    frame.Size = UDim2.new(0, 280, 0, 180)
    frame.Position = UDim2.new(0.5, -140, 0.5, -90)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    frame.BorderSizePixel = 0
    frame.Visible = false
    frame.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 40)
    title.BackgroundTransparency = 1
    title.Text = "Speed Menu"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 20
    title.Font = Enum.Font.GothamBold
    title.Parent = frame

    local textBox = Instance.new("TextBox")
    textBox.Size = UDim2.new(0.8, 0, 0, 36)
    textBox.Position = UDim2.new(0.1, 0, 0.35, 0)
    textBox.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    textBox.PlaceholderText = "Nhập số speed..."
    textBox.Text = ""
    textBox.TextSize = 16
    textBox.Font = Enum.Font.Gotham
    textBox.ClearTextOnFocus = false
    textBox.Parent = frame

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 8)
    boxCorner.Parent = textBox

    local setButton = Instance.new("TextButton")
    setButton.Size = UDim2.new(0.8, 0, 0, 36)
    setButton.Position = UDim2.new(0.1, 0, 0.6, 0)
    setButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    setButton.Text = "Set Speed"
    setButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    setButton.TextSize = 16
    setButton.Font = Enum.Font.GothamBold
    setButton.Parent = frame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = setButton

    local closeButton = Instance.new("TextButton")
    closeButton.Size = UDim2.new(0, 30, 0, 30)
    closeButton.Position = UDim2.new(1, -35, 0, 5)
    closeButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    closeButton.Text = "X"
    closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeButton.TextSize = 16
    closeButton.Font = Enum.Font.GothamBold
    closeButton.Parent = frame

    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(0, 6)
    closeCorner.Parent = closeButton

    local function toggleMenu()
        frame.Visible = not frame.Visible
        if frame.Visible then
            textBox:CaptureFocus()
        end
    end

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.P then
            toggleMenu()
        end
    end)

    setButton.MouseButton1Click:Connect(function()
        local speed = tonumber(textBox.Text)
        if speed then
            if speed < 0 then speed = 0 end
            if speed > 200 then speed = 200 end

            local character = player.Character
            if character and character:FindFirstChild("Humanoid") then
                character.Humanoid.WalkSpeed = speed
                setButton.Text = "Đã set! (" .. speed .. ")"
                task.wait(0.9)
                setButton.Text = "Set Speed"
            end
            textBox.Text = ""
        else
            textBox.Text = ""
            textBox.PlaceholderText = "Số không hợp lệ!"
            task.wait(1.2)
            textBox.PlaceholderText = "Nhập số speed..."
        end
    end)

    closeButton.MouseButton1Click:Connect(function()
        frame.Visible = false
    end)
end)

if not success then
    warn("Lỗi script:", err)
end
